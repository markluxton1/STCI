-- Actual nonendpoint target-fiber identities. Every parameter stratum used
-- geometrically is stated in the companion proof; no generic rank claim.
fiberCheck=(label,condition)->(assert(condition);print("PASS "|label));
R=QQ[delta,a,Bc,Gc,Jc,p,r,T,lam];
U3=r^3-r*T;
U4=r^4-(2*r^2+r)*T+T^2;
X0=U4+a*T;
X1=U4-delta*U3+(a+Bc)*T;
X2=(U4-3*delta*U3+3*delta^2*r^2-delta^3*r+(Gc+a+3*Bc)*T);
X3=(U4-4*delta*U3+6*delta^2*r^2-4*delta^3*r+delta^4+(Jc+2*Gc+a+4*Bc)*T);
F1=delta*r^3-(delta*r+Bc)*T-p*lam;
F2=3*delta^2*r^2-delta^3*r+Gc*T-p^2*(3-p)*lam;
F3=delta^4-2*delta^3*r+Jc*T+p^3*(2-p)*lam;
fiberCheck("actual-first-coordinate-combination",X0-X1==delta*r^3-(delta*r+Bc)*T);
fiberCheck("actual-second-coordinate-combination",X2-3*X1+2*X0==3*delta^2*r^2-delta^3*r+Gc*T);
fiberCheck("actual-third-coordinate-combination",X3-2*X2+2*X1-X0==delta^4-2*delta^3*r+Jc*T);
fiberCheck("target-third-combination",(1-p)^4-2*(1-p)^3+2*(1-p)-1==-p^3*(2-p));
H12=Gc+p*(3-p)*(delta*r+Bc);
H13=Jc-p^2*(2-p)*(delta*r+Bc);
R2=-delta*r*(p*r-delta)*((3-p)*r-delta);
R3=delta*(p*r-delta)*(p*(2-p)*r^2+delta*(2-p)*r-delta^2);
J0=(p*T^2+(delta*r+Bc-p*(2*r^2+r-a))*T+r^3*(p*r-delta));
fiberCheck("all-p-nonzero-affine-elimination",F2-p*(3-p)*F1==H12*T+R2 and F3+p^2*(2-p)*F1==H13*T+R3 and p*X0-delta*r^3+(delta*r+Bc)*T==J0);
Z=Gc*p*(2-p)+Jc*(3-p);
Ac=(3*delta^2+Gc)*p*(2-p)+Jc*(3-p);
Q2=(Ac*r^2+delta*(delta^2*p*(p-3)+3*Bc*p*(2-p)+Gc*(2-p)-Jc)*r+delta^2*(Bc*p*(p-3)-Gc));
fiberMatrix=matrix{{-delta*r-Bc,-p,delta*r^3},{Gc,-p^2*(3-p),3*delta^2*r^2-delta^3*r},{Jc,p^3*(2-p),delta^4-2*delta^3*r}};
fiberCheck("determinant-quadratic-residual",det fiberMatrix==delta*p*(p*r-delta)*Q2 and H12*R3-H13*R2==delta*(p*r-delta)*Q2);
N=delta^2*(p*r-delta)*(3*(2-p)*r-delta*(3-p));
M=delta^2*(3*Jc*r^2+delta*(2*Gc-Jc)*r-delta^2*Gc);
fiberCheck("Cramer-two-equations",Z*(3*delta^2*r^2-delta^3*r)-Gc*N-(3-p)*M==0 and Z*(delta^4-2*delta^3*r)-Jc*N+p*(2-p)*M==0);
fiberCheck("Cramer-first-equation",p*Z*delta*r^3+p*(delta*r+Bc)*N-M==delta*(p*r-delta)*Q2);
Psi=(p^2*Z^2*r^4+p^2*Z*(2*r^2+r-a)*N+p^2*N^2-M*Z);
Cubic=Psi//(p*r-delta);
fiberCheck("normalization-cubic-residual",Psi==(p*r-delta)*Cubic);
Pzero=Jc*r^3-delta^2*(delta*r+Bc)*(2*r-delta);
Qzero=Jc*(3*r^2-delta*r)+Gc*delta*(2*r-delta);
DeltaOne=(Gc*(Gc+3*delta^2)*(Gc+delta^2+2*Bc)+Jc*((delta^2-5*Bc)*Gc-3*Bc*(delta^2+3*Bc))-Bc*Jc^2);
fiberCheck("target-one-two-polynomials",Jc*delta*r^3-(delta*r+Bc)*(2*delta^3*r-delta^4)==delta*Pzero and Jc*(3*delta^2*r^2-delta^3*r)+Gc*(2*delta^3*r-delta^4)==delta^2*Qzero);
fiberCheck("target-one-resultant",resultant(Pzero,Qzero,r)==-Jc^2*delta^6*DeltaOne);
Pinf=-delta^2*r^2+(Bc^2-delta*Bc+a*delta^2)*r+a*delta*Bc;
Qinf=(3*delta^2+Gc)*r^2+(3*delta*Bc-delta^3)*r-delta^2*Bc;
Dr=delta*r+Bc;
fiberCheck("target-infinity-normalization",Dr^2*r^4-(2*r^2+r-a)*delta*r^3*Dr+delta^2*r^6==r^3*Pinf);
fiberCheck("target-infinity-linear",Dr*(3*delta^2*r^2-delta^3*r)+Gc*delta*r^3==delta*r*Qinf);
fiberCheck("rank-one-extra-fiber",p*(2-p)*delta^2+delta^2*(2-p)*(3-p)-delta^2*(3-p)^2==-delta^2*(p^2-3*p+3));

pureRing=QQ[del2,pp];
pureField=frac pureRing;
rs=del2*(3-pp)/(3*(2-pp));
ls=del2^4/(3*pp^2*(2-pp)^2);
P6=pp^2-3*pp+3;
Pc=pp^2-6*pp+6;
ts=-del2^2*P6*Pc/(9*pp*(2-pp)^2*(3-pp));
Vpure=pp*(3-pp)^2*P6-9*del2*(2-pp);
fiberCheck("pure-subfamily-three-target-constraints",del2*rs^3-del2*rs*ts-pp*ls==0 and 3*del2^2*rs^2-del2^3*rs-pp^2*(3-pp)*ls==0 and del2^4-2*del2^3*rs+pp^3*(2-pp)*ls==0);
fiberCheck("pure-subfamily-normalization",rs^4-(2*rs^2+rs)*ts+ts^2-ls==del2^3*Pc*Vpure/(27*pp^2*(2-pp)^3*(3-pp)^2));
fiberCheck("pure-subfamily-special-values",sub(Vpure,{pp=>0})==-18*del2 and sub(Vpure,{pp=>2})==2 and sub(Vpure,{pp=>3})==9*del2);
print "PASS all seventeen nonendpoint target-fiber checks";
