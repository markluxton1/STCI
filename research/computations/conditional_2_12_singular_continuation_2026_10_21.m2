syzygies={(bb^2-aa*cc)*tt#0-aa*bb*tt#1+aa^2*tt#2,bb*cc*tt#0-aa*cc*tt#1+aa^2*tt#3,cc^2*tt#0-aa*cc*tt#2+aa*bb*tt#3,cc^2*tt#1-bb*cc*tt#2+(bb^2-aa*cc)*tt#3};
