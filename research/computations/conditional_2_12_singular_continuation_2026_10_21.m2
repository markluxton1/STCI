-- Generic two-node B1=B2=C1=1,C2=w; only actual torus/factor scales used.
R=QQ[w,A1,D1,A2,D2,h4,h5,h6,h7,eta,iv,MonomialOrder=>GRevLex];
firstEquations={1/2*A1+1/2*A2+w*A1-6*w*D1-w*h6-A2*h7+w*w*A2-6*w*w*D2-w*A1*h7+A1*D1*A2-3*D1*D1*A2-w*A1*A1*D1+3*w*A1*D1*D1-w*A2*A2*D2+3*w*A2*D2*D2+A1*D1*A2*h7+A1*A2*D2*h7+A2*A2*A2*h4+w*w*A1*A2*D2-3*w*w*A1*D2*D2+w*A1*A1*A1*h4+A1*A1*A1*A2*h5+A1*D1*A2*D2*h6+A1*A2*A2*A2*h5-w*A1*A1*A1*A1*D1*h4-A1*A1*A1*A1*D1*A2*h5-w*w*A2*A2*A2*A2*D2*h4-w*w*A1*A2*A2*A2*A2*D2*h5,1/2+1/2*w-w*h7-3/2*A1*A2+3/2*A1*D2+3/2*D1*A2+w*A1*D1-3*w*D1*D1+D1*A2*h7+A2*D2*h7+w*w*A2*D2-3*w*w*D2*D2-w*A1*A1*h4+w*A1*D1*h7+w*A1*D2*h7-w*A2*A2*h4-A1*A1*A2*h5+D1*A2*D2*h6+w*A1*D1*D2*h6-w*A1*A2*A2*h5-A1*D1*D1*A2*h7-A1*D1*A2*D2*h7-A1*A2*D2*D2*h7+A2*A2*A2*D2*h4+w*A1*A1*A1*D1*h4+A1*A1*A1*D1*A2*h5-A1*D1*D1*A2*D2*h6-A1*D1*A2*D2*D2*h6+A1*A2*A2*A2*D2*h5,-A2+3/2*D2-w*A1+3/2*w*D1+w*A1*h4+w*D1*h7+w*D2*h7+3/8*A1*A1*A2-1/2*A1*D1*A2+3/8*A1*A2*A2-1/2*A1*A2*D2+A1*A2*h5+w*w*A2*h4+w*D1*D2*h6-D1*D1*A2*h7-D1*A2*D2*h7-A2*D2*D2*h7+w*w*A1*A2*h5-w*A1*A1*D1*h4-w*A1*D1*D1*h7-w*A1*D1*D2*h7-w*A1*D2*D2*h7-w*A2*A2*D2*h4-A1*A1*D1*A2*h5-D1*D1*A2*D2*h6-D1*A2*D2*D2*h6-w*A1*D1*D1*D2*h6-w*A1*D1*D2*D2*h6-w*A1*A2*A2*D2*h5+A1*D1*D1*D1*A2*h7+A1*D1*D1*A2*D2*h7+A1*D1*A2*D2*D2*h7+A1*A2*D2*D2*D2*h7+A1*D1*D1*D1*A2*D2*h6+A1*D1*D1*A2*D2*D2*h6+A1*D1*A2*D2*D2*D2*h6,-1/2*w-h4-w*h4+3/4*A1*A2-A1*h5-1/2*D1*A2+3/8*A2*A2-1/2*A2*D2-A2*h5+3/8*w*A1*A1-1/2*w*A1*D1+3/4*w*A1*A2-1/2*w*A1*D2+w*A1*D1*h4-w*D1*D1*h7-w*D1*D2*h7-w*D2*D2*h7-3/8*A1*A1*D1*A2+1/2*A1*D1*D1*A2+A1*D1*A2*h5-3/8*A1*A2*A2*D2+1/2*A1*A2*D2*D2+w*w*A2*D2*h4-w*D1*D1*D2*h6-w*D1*D2*D2*h6+D1*D1*D1*A2*h7+D1*D1*A2*D2*h7+D1*A2*D2*D2*h7+A2*D2*D2*D2*h7+w*w*A1*A2*D2*h5+w*A1*D1*D1*D1*h7+w*A1*D1*D1*D2*h7+w*A1*D1*D2*D2*h7+w*A1*D2*D2*D2*h7+D1*D1*D1*A2*D2*h6+D1*D1*A2*D2*D2*h6+D1*A2*D2*D2*D2*h6+w*A1*D1*D1*D1*D2*h6+w*A1*D1*D1*D2*D2*h6+w*A1*D1*D2*D2*D2*h6-A1*D1*D1*D1*D1*A2*h7-A1*D1*D1*D1*A2*D2*h7-A1*D1*D1*A2*D2*D2*h7-A1*D1*A2*D2*D2*D2*h7-A1*A2*D2*D2*D2*D2*h7-A1*D1*D1*D1*D1*A2*D2*h6-A1*D1*D1*D1*A2*D2*D2*h6-A1*D1*D1*A2*D2*D2*D2*h6-A1*D1*A2*D2*D2*D2*D2*h6,1-h7-w*h7+A1*D1+A1*D2-3*D1*D1-6*D1*D2-D2*h6-w*D1*h6-A1*A1*h4+A1*D1*h7+A2*D2*h7+w*w*D1*A2-6*w*w*D1*D2+w*w*A2*D2-3*w*w*D2*D2-w*A2*A2*h4-A1*A1*D1*D2+3*A1*D1*D1*D2+A1*D1*D2*h6+D1*A2*D2*h6-w*w*A1*A2*h4-w*A1*A2*A2*h5-w*D1*A2*A2*D2+3*w*D1*A2*D2*D2+A1*A1*A1*D1*h4+A1*A1*A1*D2*h4+D1*A2*A2*A2*h4+A2*A2*A2*D2*h4-w*w*A1*A1*A2*h5+w*A1*D1*A2*A2*h4+w*A1*A2*A2*D2*h4+A1*D1*A2*A2*A2*h5+A1*A2*A2*A2*D2*h5+w*w*A1*A1*D1*A2*h4+w*w*A1*A1*A2*D2*h4+w*A1*A1*D1*A2*A2*h5+w*A1*A1*A2*A2*D2*h5-A1*A1*A1*A1*D1*D2*h4-A1*D1*A2*A2*A2*D2*h4+w*w*A1*A1*A1*D1*A2*h5+w*w*A1*A1*A1*A2*D2*h5-w*A1*A1*D1*A2*A2*D2*h4-A1*A1*D1*A2*A2*A2*D2*h5-w*w*A1*A1*A1*D1*A2*D2*h4-w*w*D1*A2*A2*A2*A2*D2*h4-w*A1*A1*A1*D1*A2*A2*D2*h5-w*w*A1*A1*A1*A1*D1*A2*D2*h5-w*w*A1*D1*A2*A2*A2*A2*D2*h5,-3/4*A1+2*D1-3/4*A2+2*D2+A1*h4+D1*h7+w*D2*h7+A1*D1*D2-3*D1*D1*D2+D1*D2*h6+w*w*A2*h4+w*D1*D2*h6-A1*A1*D1*h4-A1*A1*D2*h4-A1*D1*D1*h7-A2*D2*D2*h7+w*w*A1*A2*h5+w*w*D1*A2*D2-3*w*w*D1*D2*D2-w*D1*A2*A2*h4-w*A2*A2*D2*h4-A1*D1*D1*D2*h6-D1*A2*D2*D2*h6-w*w*A1*D1*A2*h4-w*w*A1*A2*D2*h4-w*A1*D1*A2*A2*h5-w*A1*A2*A2*D2*h5+A1*A1*A1*D1*D2*h4+D1*A2*A2*A2*D2*h4-w*w*A1*A1*D1*A2*h5-w*w*A1*A1*A2*D2*h5+w*A1*D1*A2*A2*D2*h4+A1*D1*A2*A2*A2*D2*h5+w*w*A1*A1*D1*A2*D2*h4+w*A1*A1*D1*A2*A2*D2*h5+w*w*A1*A1*A1*D1*A2*D2*h5,-1/4-1/4*w-h4+3/8*A1*A1-1/2*A1*D1-3/4*A1*D2-3/4*D1*A2+3*D1*D2+3/8*A2*A2-1/2*A2*D2+A1*D1*h4+A1*D2*h4-D1*D1*h7-w*D2*D2*h7-D1*D1*D2*h6+w*w*D1*A2*h4+w*w*A2*D2*h4-w*D1*D2*D2*h6-A1*A1*D1*D2*h4+A1*D1*D1*D1*h7+A2*D2*D2*D2*h7+w*w*A1*D1*A2*h5+w*w*A1*A2*D2*h5-w*D1*A2*A2*D2*h4+A1*D1*D1*D1*D2*h6+D1*A2*D2*D2*D2*h6-w*w*A1*D1*A2*D2*h4-w*A1*D1*A2*A2*D2*h5-w*w*A1*A1*D1*A2*D2*h5,3/4*A1-1/2*D1-1/4*D2-h5-1/4*w*D1+3/4*w*A2-1/2*w*D2-D1*h4-D2*h4-3/8*A1*A1*D1+3/8*A1*A1*D2+1/2*A1*D1*D1-1/2*A1*D1*D2+3/8*D1*A2*A2-1/2*D1*A2*D2-3/8*A2*A2*D2+1/2*A2*D2*D2+A1*D1*D2*h4+D1*D1*D1*h7+w*D2*D2*D2*h7+D1*D1*D1*D2*h6+w*w*D1*A2*D2*h4+w*D1*D2*D2*D2*h6-A1*D1*D1*D1*D1*h7-A2*D2*D2*D2*D2*h7+w*w*A1*D1*A2*D2*h5-A1*D1*D1*D1*D1*D2*h6-D1*A2*D2*D2*D2*D2*h6};
normSymbolEquations={1/2*A1+D1+1/2*w*A2+w*D2+1/4*A1*A1*A1-1/2*A1*A1*D1-A1*D1*D1+2*D1*D1*D1+1/4*A2*A2*A2-1/2*A2*A2*D2-A2*D2*D2+2*D2*D2*D2,1/2*A1-2*D1-w*A2+w*D2-1/2*A1*A1*D1+2*A1*D1*D1-2*D1*D1*D1-1/4*A2*A2*A2+A2*A2*D2-A2*D2*D2};
kappa1=1/2*A1+D1+1/4*A1*A1*A1-1/2*A1*A1*D1-A1*D1*D1+2*D1*D1*D1;
tau=A1*D2+A2*D1-1-w;
delta=(A1*D1-1)*(A2*D2-w);
twoNodeGenericOpen=kappa1*delta*(tau^2-4*delta);
baseIdeal=ideal join(firstEquations,normSymbolEquations,{w^3-1,iv*twoNodeGenericOpen-1});
S=R[zz];
aa=(A1*A2)*zz^0+(A2+w*A1)*zz^1+(w)*zz^2;
bb=(A1+A2)*zz^0+(1+w+A1*D2+D1*A2)*zz^1+(D2+w*D1)*zz^2;
cc=(1)*zz^0+(D1+D2)*zz^1+(D1*D2)*zz^2;
ttau1=1+(D1-A1/2)*zz-zz^2/2;
ttau2=1+(D2-A2/2)*zz-w*zz^2/2;
ttau=ttau1*ttau2;
coeffR=(p,j)->sub(coefficient(zz^j,p),R);
uu=coeffR(ttau,0)+coeffR(ttau,3)*zz^3;
vv=coeffR(ttau,1)*zz+coeffR(ttau,4)*zz^4;
ww=coeffR(ttau,2)*zz^2;
alphaCanonical=uu^2+vv^2+ww^2-uu*vv-uu*ww-vv*ww;
afVector=flatten apply({aa,bb,cc},p->apply(11,j->coeffR(alphaCanonical*p,j)));
