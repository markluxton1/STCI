-- Selected ideal and Hilbert-polynomial checks for the deformation notebook.
-- This is a finite coordinate experiment, not generic smoothness verification.
R=QQ[x0,x1,x2,x3];
T=QQ[s,t];
phi=map(T,R,{s^4,s^3*t,s*t^3,t^4});
IC=ker phi;
q=x0*x3-x1*x2;
a=x1^3-x0^2*x2;
b=x0*x2^2-x1^2*x3;
c=x2^3-x1*x3^2;
assert(IC==ideal(q,a,b,c));
f=x1^4-x0^3*x3;
g=x2^4-x0*x3^3;
j0=trim(ideal(f,g):IC);
j1=trim(ideal(f,g+q*x0^2):IC);
assert(degree(R/j0)==12 and degree(R/j1)==12);
-- P_1(n)=n+1; -27P_0+12P_1 = 12n-15, so p_a=16.
assert(hilbertPolynomial(R/j0)==hilbertPolynomial(R/j1));
assert(hilbertPolynomial(R/j1)==-27*hilbertPolynomial(R/ideal(x0,x1,x2)) + 12*hilbertPolynomial(R/ideal(x0,x1)));
assert(degree(R/saturate(j1+IC))==18);
print "Ideal generated by Q and three cubics: PASS";
print "Special and lambda=1 residuals: degree12, Hilbert polynomial12n-15: PASS";
print "lambda=1 attachment scheme length18: PASS";
