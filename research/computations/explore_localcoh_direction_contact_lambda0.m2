I=ideal(a0*a7 - a1*a4 + a2*a3,a0*a8 - a1*a5 - a3*a6,a0*a9 - a1*a10 + a3*a5,-a0*a15/3 + a1*a11/3 - a1*a9/3 - a12*a3/3 - a3*a8/3,a0*a10 - a1*a6,a0*a11 - a2*a5 - a4*a6,a0*a14 - a10*a2 + a4*a5,2*a0*a13/3 + a11*a2/3 - a12*a4/3 - a2*a9/3 - a4*a8/3,a0*a12 - a2*a6,a0*a13 + a10*a6 + a5^2,-a11*a6/3 - a12*a5/3 - a5*a8/3 + a6*a9/3,a0*a14 + a6^2,-a10*a12/3 - a10*a8/3 + a11*a5/3 - a5*a9/3,a0*a15 - a5*a6,a12*a6/3 + a6*a8/3,a1*a11 - a2*a8 - a6*a7,a1*a14 - a2*a9 + a5*a7,2*a1*a13/3 - a12*a7/3 + a15*a2/3 - a7*a8/3,a1*a12 - a10*a2,a1*a13 + a5*a8 + a6*a9,-a12*a8/3 - a15*a6/3 - a8^2/3,a1*a14 + a10*a6,-a12*a9/3 + a15*a5/3 - a8*a9/3,a1*a15 - a10*a5,a10*a12/3 + a10*a8/3,a11*a5 + a13*a2 + a14*a6,-a11*a12/3 - a11*a8/3 + 2*a13*a6/3,a12*a6 + a14*a2,-a12*a14/3 - 2*a13*a5/3 - a14*a8/3,-a12*a5 + a15*a2,a12^2/3 + a12*a8/3,-a12*a13/3 - a13*a8/3,-a14*a5 - a15*a6,a12*a14/3 + a14*a8/3,a12*a15/3 + a15*a8/3,a11*a3 - a4*a8 + a5*a7,a10*a7 + a14*a3 - a4*a9,-a11*a7/3 + 2*a13*a3/3 + a15*a4/3 + a7*a9/3,-a10*a4 + a12*a3 + a6*a7,a10*a8 + a13*a3 - a5*a9,-a11*a8/3 + a15*a5/3 + a8*a9/3,-a10*a5 + a14*a3 + a6*a8,a10*a15/3 - a11*a9/3 + a9^2/3,-a10^2 + a15*a3 + a6*a9,a10*a11/3 - a10*a9/3 - a15*a6/3,a10*a11 + a13*a4 - a14*a5,-a11^2/3 + a11*a9/3 - 2*a13*a5/3,a11*a6 - a12*a5 + a14*a4,-2*a10*a13/3 - a11*a14/3 + a14*a9/3,-a10*a12 + a14*a6 + a15*a4,a11*a12/3 - a12*a9/3 + 2*a13*a6/3,-a11*a13/3 + a13*a9/3,-a10*a14 + a13*a6 + a15*a5,a11*a14/3 - a14*a9/3,a11*a15/3 - a15*a9/3,a11*a9 + a13*a7 - a14*a8,-a11*a15/3 - 2*a13*a8/3,a10*a11 - a12*a8 + a14*a7,-2*a13*a9/3 - a14*a15/3,a10*a14 - a12*a9 + a15*a7,2*a10*a13/3 + a12*a15/3,-a13*a15/3,a10*a13 - a14*a9 + a15*a8,a14*a15/3,a15^2/3,2*a13^2/3,a11*a15 + a12*a13 - a14^2,-2*a13*a14/3,-2*a13*a15/3);
J=ideal(-a6,a5,-a12/3 - a8/3,a5,a10,-a11/3 + a9/3,a6,a8,a9,-a15/3,a10,a11,a14,2*a13/3,a12,a13,a14,a15);
