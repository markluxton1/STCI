-- Self-contained exact carrier geometry certificates for principal boundary fibers.
print "rhalf_unique";
R=QQ[x0,x1,x2,x3];
F=x0^3*x2 - x0^3*x3 + 6*x0^2*x1*x2 - 12*x0^2*x1*x3 - 40*x0^2*x2^2 + 32*x0^2*x2*x3 + 32*x0^2*x3^2 - x0*x1^3 + 12*x0*x1^2*x2 - 24*x0*x1^2*x3 - 112*x0*x1*x2^2 + 320*x0*x1*x2*x3 + 128*x0*x1*x3^2 + 320*x0*x2^3 - 384*x0*x2^2*x3 - 768*x0*x2*x3^2 - 256*x0*x3^3 - 5*x1^4 + 64*x1^3*x2 + 80*x1^3*x3 - 352*x1^2*x2^2 - 448*x1^2*x2*x3 - 640*x1^2*x3^2 + 1024*x1*x2^3 + 768*x1*x2^2*x3 + 1536*x1*x2*x3^2 + 1024*x1*x3^3 - 1280*x2^4 - 1024*x2^3*x3;
J=ideal(diff(x0,F),diff(x1,F),diff(x2,F),diff(x3,F));
assert(dim(R/J)==2 and degree(R/J)==5);
L1=ideal(x1-4*x2,x0-16*x3); L2=ideal(x1-12*x2-16*x3,x0+32*x2+48*x3);
I=intersect(L1,L2); Rj=radical J; assert(isSubset(Rj,I) and isSubset(I,Rj));
assert(F % ideal(x0+4*x1-16*x2-16*x3)!=0);
assert(F % ideal(x0-4*x1+16*x2-16*x3)!=0);
assert(F % ideal(x0*x3-x1*x2)!=0);
print "PASS reduced singular support two lines; candidate plane and quadric factors absent";
print "Szero_unique";
R=QQ[x0,x1,x2,x3];
F=x0^3*x2 - x0^3*x3 - 2*x0^2*x1*x2/3 + 4*x0^2*x1*x3/3 + 4*x0^2*x2^2/9 - 7*x0^2*x2*x3/9 + x0^2*x3^2/9 - x0*x1^3 - 4*x0*x1^2*x2/3 + x0*x1^2*x3 + 11*x0*x1*x2^2/9 - 8*x0*x1*x2*x3/9 + 2*x0*x1*x3^2/9 - x0*x2^3/9 + 5*x1^4/3 - 13*x1^3*x2/9 - 4*x1^3*x3/9 + 7*x1^2*x2^2/9 - x1^2*x2*x3/9 + x1^2*x3^2/9 - x1*x2^3/9;
J=ideal(diff(x0,F),diff(x1,F),diff(x2,F),diff(x3,F));
Tc=ideal(3*x1^2-3*x0*x2-5*x1*x2+x2^2+3*x0*x3+x1*x3,3*x0*x1-5*x0*x2-5*x1*x2+x2^2+4*x0*x3+2*x1*x3,9*x0^2-18*x0*x2-22*x1*x2+5*x2^2+18*x0*x3+8*x1*x3);
assert(dim(R/J)==2 and degree(R/J)==3);
assert(dim(R/Tc)==2 and degree(R/Tc)==3 and length res(coker gens Tc)==2);
assert(numgens source gens trim Tc==3);
assert(dim(R/(Tc+minors(2,jacobian gens Tc)))==0);
assert(isSubset(J,Tc));
print "PASS geometrically smooth nondegenerate twisted cubic contained in singular locus";
print "c1zero_infinity_defect";
Ka=QQ[a];
K=toField(Ka/ideal(a^2+2));
R=K[x0,x1,x2,x3];
F=x0^3*x2 - x0^3*x3 - 4*x0^2*x1*x2/3 + a*x0^2*x1*x2/3 + 8*x0^2*x1*x3/3 - 2*a*x0^2*x1*x3/3 + 32*x0^2*x2^2/9 - 17*a*x0^2*x2^2/9 - 47*x0^2*x2*x3/9 + 32*a*x0^2*x2*x3/9 + 17*x0^2*x3^2/9 - 20*a*x0^2*x3^2/9 - x0*x1^3 - 8*x0*x1^2*x2/3 + 2*a*x0*x1^2*x2/3 - x0*x1^2*x3 + a*x0*x1^2*x3 + 25*x0*x1*x2^2/9 - 13*a*x0*x1*x2^2/9 - 10*x0*x1*x2*x3/9 + 7*a*x0*x1*x2*x3/9 - 2*x0*x1*x3^2/9 + 14*a*x0*x1*x3^2/9 + x0*x2^3/9 - 7*a*x0*x2^3/9 + 7*x1^4/3 - a*x1^4/3 - 23*x1^3*x2/9 + 8*a*x1^3*x2/9 + 22*x1^3*x3/9 - 19*a*x1^3*x3/9 - 7*x1^2*x2^2/9 + 13*a*x1^2*x2^2/9 + x1^2*x2*x3/9 - 7*a*x1^2*x2*x3/9 - x1^2*x3^2/9 - 2*a*x1^2*x3^2/9 + x1*x2^3/9 + 2*a*x1*x2^3/9;
J=ideal(diff(x0,F),diff(x1,F),diff(x2,F),diff(x3,F));
Tc=ideal(3*a*x2^2+3*a*x0*x3-6*a*x1*x3-3*x0^2+17*x1^2-11*x0*x2-23*x1*x2-4*x2^2+5*x0*x3+19*x1*x3,3*a*x1*x2-3*a*x0*x3+3*x0^2-8*x1^2+2*x0*x2+2*x1*x2+x2^2+4*x0*x3-4*x1*x3,a*x0*x2-2*a*x0*x3+a*x1*x3+3*x0*x1-3*x1^2-4*x0*x2+5*x0*x3-x1*x3);
assert(dim(R/J)==2 and degree(R/J)==3);
assert(dim(R/Tc)==2 and degree(R/Tc)==3 and length res(coker gens Tc)==2);
assert(numgens source gens trim Tc==3);
assert(dim(R/(Tc+minors(2,jacobian gens Tc)))==0);
assert(isSubset(J,Tc));
print "PASS geometrically smooth nondegenerate twisted cubic contained in singular locus";
print "b0zero_cubic_orbit";
Ka=QQ[a];
K=toField(Ka/ideal(a^3-4*a^2+3*a-9));
R=K[x0,x1,x2,x3];
F=x0^3*x2 + 442*x0^2*x1*x2/979 + 235*x0^2*x1*x2*a/979 + 240*x0^2*x1*x2*a^2/979 - 2*x0^2*x1*x3*a - 599549*x0^2*x2^2*a/118459 + 734154*x0^2*x2^2/118459 + 145274*x0^2*x2^2*a^2/118459 - 34899*x0^2*x2*x3*a/10769 - 4501*x0^2*x2*x3*a^2/10769 - 32283*x0^2*x2*x3/10769 - 18*x0^2*x3^2/11 - 3*x0^2*x3^2*a/11 + 7*x0^2*x3^2*a^2/11 - x0*x1^3 + 2*x0*x1^2*x2*a - 2390*x0*x1^2*x3*a^2/979 - 4320*x0*x1^2*x3/979 + 2514*x0*x1^2*x3*a/979 - 4348*x0*x1*x2^2*a^2/979 - 4320*x0*x1*x2^2/979 + 2514*x0*x1*x2^2*a/979 - 572706*x0*x1*x2*x3*a/118459 - 147258*x0*x1*x2*x3/118459 + 212598*x0*x1*x2*x3*a^2/118459 - 44430*x0*x1*x3^2*a/10769 + 417411*x0*x1*x3^2/10769 + 198479*x0*x1*x3^2*a^2/10769 - 417471*x0*x2^3*a^2/118459 - 483606*x0*x2^3*a/118459 - 1569591*x0*x2^3/118459 - 611256*x0*x2^2*x3*a/118459 + 11899422*x0*x2^2*x3/118459 + 5151172*x0*x2^2*x3*a^2/118459 - 2673980*x0*x2*x3^2*a^2/118459 - 6460794*x0*x2*x3^2/118459 + 645306*x0*x2*x3^2*a/118459 - 7107286*x0*x3^3*a^2/118459 - 16851924*x0*x3^3/118459 + 1059078*x0*x3^3*a/118459 - 240*x1^4*a^2/979 - 235*x1^4*a/979 - 442*x1^4/979 - 211434*x1^3*x2/118459 + 295355*x1^3*x2*a/118459 + 143916*x1^3*x2*a^2/118459 + 7245*x1^3*x3*a/10769 + 79803*x1^3*x3/10769 + 52329*x1^3*x3*a^2/10769 - 287981*x1^2*x2^2*a^2/118459 + 341100*x1^2*x2^2/118459 + 605013*x1^2*x2^2*a/118459 - 1765798*x1^2*x2*x3*a^2/118459 - 3021930*x1^2*x2*x3/118459 + 972336*x1^2*x2*x3*a/118459 - 4284024*x1^2*x3^2*a^2/118459 - 10665405*x1^2*x3^2/118459 + 1120707*x1^2*x3^2*a/118459 - 867148*x1*x2^3*a^2/118459 - 509451*x1*x2^3*a/118459 - 1234017*x1*x2^3/118459 - 645306*x1*x2^2*x3*a/118459 + 6460794*x1*x2^2*x3/118459 + 2673980*x1*x2^2*x3*a^2/118459 - 134223*x1*x2*x3^2*a/118459 + 5328009*x1*x2*x3^2/118459 + 2001203*x1*x2*x3^2*a^2/118459 - 2234967*x1*x3^3*a/118459 + 31982787*x1*x3^3/118459 + 13685033*x1*x3^3*a^2/118459 - 924855*x2^4*a/118459 + 11523915*x2^4/118459 + 5106083*x2^4*a^2/118459 - 13685033*x2^3*x3*a^2/118459 - 31982787*x2^3*x3/118459 + 2234967*x2^3*x3*a/118459;
J=ideal(diff(x0,F),diff(x1,F),diff(x2,F),diff(x3,F));
assert(dim(R/J)==1);
print "PASS finite projective singular locus, geometrically integral normal quartic";
print "PASS principal boundary carrier geometry certificates";
