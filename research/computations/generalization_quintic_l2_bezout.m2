-- Capture literal characteristic-zero Bezout witnesses for new eliminations.
outdir="research/validation/2026-10-13-generalization-quintic-l2";
save=(label,f)->((outdir|"/"|label|".txt") << toExternalString f << close);
sourceRing=QQ[qpar,mpar];
r34=value get(outdir|"/R34.txt"); r35=value get(outdir|"/R35.txt");
n3=value get(outdir|"/cover-f3-numerator.txt");
n4=value get(outdir|"/cover-f4-numerator.txt");
n5=value get(outdir|"/cover-f5-numerator.txt");
g3=value get(outdir|"/generic-g3.txt");
g4=value get(outdir|"/generic-g4.txt");
g5=value get(outdir|"/generic-g5.txt");
Pc=qpar^2-6*qpar+6;
H=qpar^4*mpar^2+3*qpar^4*mpar-3*qpar^3*mpar^2-3*qpar^4-15*qpar^3*mpar+3*qpar^2*mpar^2+36*qpar^3+27*qpar^2*mpar-144*qpar^2-18*qpar*mpar+216*qpar-108;
assert(n3==(qpar-2)^5*Pc^7*H*g3);
assert(n4==(qpar-2)^5*Pc^7*g4);
assert(n5==(qpar-2)^5*Pc^7*g5);
print "PASS three literal normalizations";
univ=QQ[qr]; phi=map(univ,sourceRing,{qr,0_univ});
R34=phi r34; R35=phi r35;
G=qr^53*(qr-2)^44*(qr^2-6*qr+6)^69;
pair=matrix{{R34,R35}};
bezCoef=matrix{{G}} // pair;
assert(pair*bezCoef==matrix{{G}});
save("generic-resultant-bezout",bezCoef);
save("generic-resultant-pair",pair);save("generic-resultant-target",G);
print "PASS literal original-resultant Bezout identity";
sourceDrop=QQ[dp,qp]; sf=frac sourceDrop; use sf;
v3=value get(outdir|"/D0-f3.txt");
v4=value get(outdir|"/D0-f4.txt");
dropUniv=QQ[qd]; dropMap=map(dropUniv,sourceDrop,{0_dropUniv,qd});
dropPair=matrix{{dropMap numerator v3,dropMap numerator v4}};
dropCoef=matrix{{qd^4}} // dropPair;
assert(dropPair*dropCoef==matrix{{qd^4}});
save("D0-bezout",dropCoef);save("D0-bezout-pair",dropPair);
print "PASS literal D0 numerator Bezout identity";
print "COMPLETE three normalization and two Bezout checks";
