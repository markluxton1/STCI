R=QQ[delta,a,B,G,J,p,q,kappa,tt];
F=value get "research/validation/2026-10-12-nonendpoint-diagonal-norm/20261012T212553449292Z/primitive-polynomial.txt";
Gs=-(6*B+delta^2-3*delta)*q-(3*a-3*B+2*delta)*q^2+2*a*q^3;
Js=(-Gs*(1+3*q)-(6*B+5*delta^2-3*delta)*q-(3*a+3*B+delta-delta^2)*q^2+(a+B)*q^3)/2;
Fs=sub(sub(sub(F,{G=>Gs,J=>Js,p=>q+tt}),{B=>kappa-a*q}),{q=>2});
cc=apply(0..8,n->(sum select(terms Fs,mm->((exponents mm)#0)#8==n))//tt^n);
L=6*kappa^2-6*delta*(delta+2)*kappa+delta^2*(delta^2+6*delta+6);
scan(1..4,n->print("F coefficient "|toString n|"="|toString factor cc#n));
print("f2 A resultant="|toString factor resultant(diff(a,cc#2),L,kappa));
print "COMPLETE q2 exploration";
nums=QQ[mm]; NF=toField(nums/ideal(mm^2-3));
BR=NF[dpar,aa];
km=dpar+(3+sub(mm,BR))*dpar^2/6;
phi=map(BR,R,{dpar,aa,0_BR,0_BR,0_BR,0_BR,2_BR,km,0_BR});
bc=apply(1..8,n->phi cc#n);
scan(1..3,n->print("rationalized f"|toString(n+1)|"="|toString factor bc#n));
print("f2 f3 saturated dim="|toString(dim(saturate(ideal(bc#1,bc#2),ideal dpar))));
print("f2 f3 f4 saturated ideal="|toString(saturate(ideal(bc#1,bc#2,bc#3),ideal dpar)));
scan(4..7,n->print("remaining coefficient at candidate "|toString(n+1)|"="|toString sub(bc#n,{dpar=>-2*sub(mm,BR)/3,aa=>(sub(mm,BR)-4)/9})));
print("f2 f3 f4 f5 saturated ideal="|toString(saturate(ideal(bc#1,bc#2,bc#3,bc#4),ideal dpar)));
jd=phi sub(Js,{B=>kappa-a*q}); gd=phi sub(Gs,{B=>kappa-a*q});
print("candidate J="|toString sub(jd,{dpar=>-2*sub(mm,BR)/3,aa=>(sub(mm,BR)-4)/9}));
print("candidate G="|toString sub(gd,{dpar=>-2*sub(mm,BR)/3,aa=>(sub(mm,BR)-4)/9}));
print "COMPLETE q2 exact ideal exploration";
