linN1=apply(linrows,rr->(matrix(q,1,(ii,jj)->0_K))||((-transpose rr)//BT));
gN0=(transpose Fh)||((-transpose(Fh*A))//BT);
gN1=(-transpose Fa)||((transpose(Fa*A-Fh))//BT);
gN2=matrix(q,1,(ii,jj)->0_K)||((transpose Fa)//BT);
