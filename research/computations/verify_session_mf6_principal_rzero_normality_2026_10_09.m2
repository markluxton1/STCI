-- Exact r=0 cubic-field carrier; all three characteristic-zero embeddings.
A=QQ[p];
K=toField(A/ideal(8*p^3-16*p^2+6*p-9));
R=K[x0,x1,x2,x3];
F=16300486656*p^2*x0^3*x2 - 16300486656*p^2*x0^3*x3 - 22153015296*p^2*x0^2*x1*x2 + 8568281088*p^2*x0^2*x1*x3 - 90698517504*p^2*x0^2*x2^2 + 42867906048*p^2*x0^2*x2*x3 + 16770872448*p^2*x0^2*x3^2 - 16300486656*p^2*x0*x1^3 - 8568281088*p^2*x0*x1^2*x2 - 48377419776*p^2*x0*x1^2*x3 - 132650846208*p^2*x0*x1*x2^2 - 2219705856*p^2*x0*x1*x2*x3 - 31680450432*p^2*x0*x1*x3^2 - 4942363392*p^2*x0*x2^3 - 2318989824*p^2*x0*x2^2*x3 + 9723786912*p^2*x0*x2*x3^2 + 38453501952*p^2*x1^4 + 139075937280*p^2*x1^3*x2 + 89782940160*p^2*x1^3*x3 - 14551166592*p^2*x1^2*x2^2 + 36622813824*p^2*x1^2*x2*x3 + 30253080096*p^2*x1^2*x3^2 - 27934090272*p^2*x1*x2^3 - 9723786912*p^2*x1*x2^2*x3 + 303310656*p^2*x1*x2*x3^2 + 708325560*p^2*x1*x3^3 - 303310656*p^2*x2^4 - 708325560*p^2*x2^3*x3 + 5434490880*p*x0^3*x2 - 5434490880*p*x0^3*x3 + 145452506112*p*x0^2*x1*x2 - 52663799808*p*x0^2*x1*x3 + 181550999808*p*x0^2*x2^2 - 69106493952*p*x0^2*x2*x3 - 46478707200*p*x0^2*x3^2 - 5434490880*p*x0*x1^3 + 52663799808*p*x0*x1^2*x2 + 80717865984*p*x0*x1^2*x3 + 254197191168*p*x0*x1*x2^2 - 49438190592*p*x0*x1*x2*x3 + 68849116128*p*x0*x1*x3^2 - 12732072480*p*x0*x2^3 - 6299049888*p*x0*x2^2*x3 - 22280876064*p*x0*x2*x3^2 - 140018015232*p*x1^4 - 262268865792*p*x1^3*x2 - 185090697216*p*x1^3*x3 + 95916897792*p*x1^2*x2^2 - 56117043648*p*x1^2*x2*x3 - 44313017328*p*x1^2*x3^2 + 50612067216*p*x1*x2^3 + 22280876064*p*x1*x2^2*x3 - 848590992*p*x1*x2*x3^2 - 334873440*p*x1*x3^3 + 848590992*p*x2^4 + 334873440*p*x2^3*x3 - 72411604992*x0^3*x2 + 72411604992*x0^3*x3 - 197956182528*x0^2*x1*x2 + 71000727552*x0^2*x1*x3 - 10226342016*x0^2*x2^2 - 29505394368*x0^2*x2*x3 + 27301108320*x0^2*x3^2 + 72411604992*x0*x1^3 - 71000727552*x0*x1^2*x2 + 16928849664*x0*x1^2*x3 + 3057740928*x0*x1*x2^2 + 102622438080*x0*x1*x2*x3 - 14414464512*x0*x1*x3^2 + 37808156160*x0*x2^3 + 23935997664*x0*x2^2*x3 + 8632333944*x0*x2*x3^2 + 125544577536*x1^4 - 6702507648*x1^3*x2 + 26447653440*x1^3*x3 - 129923546400*x1^2*x2^2 - 23393691648*x1^2*x2*x3 - 26625745224*x1^2*x3^2 + 2689747560*x1*x2^3 - 8632333944*x1*x2^2*x3 - 1505867598*x1*x2*x3^2 - 2734815069*x1*x3^3 + 1505867598*x2^4 + 2734815069*x2^3*x3;
J=ideal(diff(x0,F),diff(x1,F),diff(x2,F),diff(x3,F));
assert(dim(R/J)==1);
print("PASS r0 quartic Jacobian cone dimension1,degree",degree(R/J));
