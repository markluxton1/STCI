print("starting polynomial module syzygy");
sy=syz transpose L;
w=sy^{72};
print("syz columns="|toString numColumns sy);
print("eval ideal unit="|toString(1_R%gb ideal w==0));
coef=matrix{{1_R}}//w;
assert(w*coef==matrix{{1_R}});
n=sy*coef;
assert(transpose(n)*L==0);
assert(n_(72,0)==1_R);
print("polynomial dual constructed");
out=openOut "research/computations/localcoh-incidence-parity-dual-2026-10-06.txt";
for i from 0 to 73 do if n_(i,0)!=0 then out << i << " " << toString n_(i,0) << endl;
close out;
