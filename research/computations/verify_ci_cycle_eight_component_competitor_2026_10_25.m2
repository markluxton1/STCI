R=QQ[x0,x1,x2,x3];
T=QQ[s,t];
phi=map(T,R,{s^4,s^3*t,s*t^3,t^4});
IC=ker phi;
qq=x0*x3-x1*x2;
rr=x0*x2^2-x1^2*x3;
l1=x0+x1+x2+x3;
l2=x0+2*x1+3*x2+5*x3;
l3=x0+7*x1+11*x2+13*x3;
I=saturate ideal(qq*l1*l2,rr*l3);
pieces={IC,ideal(x0,x1),ideal(x2,x3),ideal(qq,l3),ideal(rr,l1),ideal(rr,l2),ideal(l1,l3),ideal(l2,l3)};
print(degree I);
print hilbertPolynomial(R/I, Projective=>false);
print(I==intersect pieces);
print apply(pieces,J->degree J);
print apply(pieces,J->isPrime J);
assert(degree I==16);
assert(I==intersect pieces);
assert all(pieces,J->isPrime J);
print "PASS: explicit degree-16 CI equals reduced eight-component union";
