qlinePseudoRemainders={-1/128*a2*a2*a2*b0+1/64*a2*a2*a2*c1-3/128*a0*a2*a2*c0*h5-3/128*a1*a2*a2*c0*h4-3/64*a2*a2*a2*c0*h10,1/128*a0*a2*a2*a2-1/64*a2*a2*a2*b1+1/32*a2*a2*a2*c2+3/256*a0*a2*a2*b0*h5-3/128*a0*a2*a2*c1*h5+3/256*a1*a2*a2*b0*h4-3/128*a1*a2*a2*c1*h4+3/128*a2*a2*a2*b0*h10+3/128*a2*a2*a2*c0*h4-3/64*a2*a2*a2*c0*h11-3/64*a2*a2*a2*c1*h10,3/256*a1*a2*a2*a2-3/512*a2*a2*a2*b2-3/512*a0*a0*a2*a2*h5-3/512*a0*a1*a2*a2*h4-3/256*a0*a2*a2*a2*h10+3/256*a0*a2*a2*b1*h5-3/128*a0*a2*a2*c2*h5+3/256*a1*a2*a2*b1*h4-3/128*a1*a2*a2*c2*h4-3/256*a2*a2*a2*b0*h4+3/128*a2*a2*a2*b0*h11+3/128*a2*a2*a2*b1*h10+3/128*a2*a2*a2*c0*h5+3/128*a2*a2*a2*c1*h4,-1/512*a2*a2*a2*a2-3/512*a0*a1*a2*a2*h5+3/512*a0*a2*a2*a2*h4-3/256*a0*a2*a2*a2*h11+3/256*a0*a2*a2*b2*h5-3/512*a1*a1*a2*a2*h4-3/256*a1*a2*a2*a2*h10+3/256*a1*a2*a2*b2*h4-3/256*a2*a2*a2*b0*h5-3/256*a2*a2*a2*b1*h4};
-- These four remainders are necessary on g4!=0 and gcd(alpha,g)=1.
-- Together with norm alpha, this includes the simple distinct-cube-root open.
qlineNecessaryIdeal=ideal join(firstEquations,normSymbolEquations,qlinePseudoRemainders);
-- On the g0*g4!=0 torus/projective chart one may normalize g0=g4=1:
qlineNormalizedIdeal=qlineNecessaryIdeal+ideal(gCoefficients#0-1,gCoefficients#4-1);
-- Necessity requires alpha=(al0,...,al8) nonzero, root bpf/reduced;
-- retain those opens by projective charts or genuine saturation.
-- This exporter DOES NOT compute minors(48,globalCubicMatrix).
print "MODEL_READY: K1 plus exact global cubic incidence; no elimination run";
