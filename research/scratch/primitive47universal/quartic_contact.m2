S=QQ[a0,a1,a2,b2,MonomialOrder=>GRevLex];
D=a0^2*b2^2 + 6*a0*a1*a2*b2 + 4*a0*a2^3 - 2*a1^3*b2;
M2jet=matrix{{a0*a2*b2,-a0*a1*b2,-2*a0^2*a2,0,0,0,a0^2},{-a0*b2^2/4,0,a0^2*b2/2,0,-a0^3,0,0},{0,a0*b2^2/4,0,-a0^2*b2/2,0,a0^3,0},{a2*b2^2/2,-a1*b2^2/2,-a0*a2*b2,-a0*a1*b2,-2*a0^2*a2,2*a0^2*a1,a0*b2},{-b2^3/8,0,a0*b2^2/4,0,-a0^2*b2/2,0,0},{0,b2^3/8,0,-a0*b2^2/4,0,a0^2*b2/2,0},{0,0,0,-a1*b2^2/2,-a0*a2*b2,a0*a1*b2,b2^2/4}};
M3jet=matrix{{a0^2*a1*a2*b2^4 - 2*a0^2*a2^3*b2^3 + 4*a0*a1^2*a2^2*b2^3 + 4*a0*a1*a2^4*b2^2 + 2*a1^4*a2*b2^3,-a0^3*a2*b2^4/2 - a0^2*a1^2*b2^4 - a0^2*a1*a2^2*b2^3 - 2*a0^2*a2^4*b2^2 - 3*a0*a1^3*a2*b2^3 - 4*a0*a1^2*a2^3*b2^2 - 2*a1^5*b2^3,-2*a0^3*a1*a2*b2^3 + 4*a0^3*a2^3*b2^2 - 8*a0^2*a1^2*a2^2*b2^2 - 8*a0^2*a1*a2^4*b2 - 4*a0*a1^4*a2*b2^2,a0^4*a2*b2^3 + 2*a0^3*a1^2*b2^3 + 6*a0^3*a1*a2^2*b2^2 + 4*a0^3*a2^4*b2 + 10*a0^2*a1^3*a2*b2^2 + 8*a0^2*a1^2*a2^3*b2 - 4*a0*a1^5*b2^2,4*a0^4*a1*a2*b2^2 + 24*a0^3*a1^2*a2^2*b2 + 16*a0^3*a1*a2^4 - 8*a0^2*a1^4*a2*b2,-2*a0^5*a2*b2^2 - 4*a0^4*a1^2*b2^2 - 12*a0^4*a1*a2^2*b2 - 8*a0^4*a2^4 - 20*a0^3*a1^3*a2*b2 - 16*a0^3*a1^2*a2^3 + 8*a0^2*a1^5*b2,-2*a0^3*a2^2*b2^2 - 2*a0^2*a1^2*a2*b2^2 + 4*a0*a1^4*b2^2},{-a0^2*a1*b2^5/4 + a0^2*a2^2*b2^4 - 7*a0*a1^2*a2*b2^4/2 - 5*a0*a1*a2^3*b2^3 + 4*a0*a2^5*b2^2 - a1^4*b2^4/2 + 2*a1^3*a2^2*b2^3,a0^3*b2^5/8 + a0^2*a1*a2*b2^4/4 + a0^2*a2^3*b2^3/2 + 9*a0*a1^3*b2^4/4 + 4*a0*a1^2*a2^2*b2^3 - 4*a0*a1*a2^4*b2^2 - 2*a1^4*a2*b2^3,a0^3*a1*b2^4/2 - 2*a0^3*a2^2*b2^3 + 7*a0^2*a1^2*a2*b2^3 + 10*a0^2*a1*a2^3*b2^2 - 8*a0^2*a2^5*b2 + a0*a1^4*b2^3 - 4*a0*a1^3*a2^2*b2^2,-a0^4*b2^4/4 + a0^3*a1*a2*b2^3/2 - a0^3*a2^3*b2^2 + a0^2*a1^3*b2^3/2 + 12*a0^2*a1^2*a2^2*b2^2 + 8*a0^2*a1*a2^4*b2 - 4*a0*a1^4*a2*b2^2,-a0^4*a1*b2^3 + 6*a0^4*a2^2*b2^2 - 4*a0^3*a1^2*a2*b2^2 + 20*a0^3*a1*a2^3*b2 + 16*a0^3*a2^5 - 2*a0^2*a1^4*b2^2 - 8*a0^2*a1^3*a2^2*b2,a0^5*b2^3/2 - a0^4*a1*a2*b2^2 + 2*a0^4*a2^3*b2 - a0^3*a1^3*b2^2 - 24*a0^3*a1^2*a2^2*b2 - 16*a0^3*a1*a2^4 + 8*a0^2*a1^4*a2*b2,-a0^3*a2*b2^3/2 - 5*a0^2*a1^2*b2^3/2 - 10*a0^2*a1*a2^2*b2^2 + 4*a0*a1^3*a2*b2^2},{-3*a0^2*a2*b2^5/8 + 5*a0*a1^2*b2^5/8 - a0*a1*a2^2*b2^4/2 - 5*a0*a2^4*b2^3 - 3*a1^3*a2*b2^4/2,a0^2*a1*b2^5/2 - a0^2*a2^2*b2^4/2 + 5*a0*a1^2*a2*b2^4/2 + 5*a0*a1*a2^3*b2^3 + 3*a1^4*b2^4/2,3*a0^3*a2*b2^4/4 - 5*a0^2*a1^2*b2^4/4 + a0^2*a1*a2^2*b2^3 + 10*a0^2*a2^4*b2^2 + 3*a0*a1^3*a2*b2^3,-3*a0^3*a1*b2^4/2 + a0^3*a2^2*b2^3 - 8*a0^2*a1^2*a2*b2^3 - 6*a0^2*a1*a2^3*b2^2 + a0*a1^4*b2^3,-5*a0^4*a2*b2^3/2 + 5*a0^3*a1^2*b2^3/2 - 8*a0^3*a1*a2^2*b2^2 - 12*a0^3*a2^4*b2 + 2*a0^2*a1^3*a2*b2^2,3*a0^4*a1*b2^3 - 2*a0^4*a2^2*b2^2 + 16*a0^3*a1^2*a2*b2^2 + 12*a0^3*a1*a2^3*b2 - 2*a0^2*a1^4*b2^2,a0^3*b2^4/4 + 3*a0^2*a1*a2*b2^3/2 - 2*a0^2*a2^3*b2^2 - 2*a0*a1^3*b2^3},{a0^2*b2^6/16 + 17*a0*a1*a2*b2^5/8 + 3*a0*a2^3*b2^4/2 + a1^3*b2^5/4 + 5*a1^2*a2^2*b2^4 + 4*a1*a2^4*b2^3,-a0^2*a2*b2^5/8 - 19*a0*a1^2*b2^5/8 - 3*a0*a1*a2^2*b2^4 - 4*a1^3*a2*b2^4 - 4*a1^2*a2^3*b2^3,-a0^3*b2^5/8 - 17*a0^2*a1*a2*b2^4/4 - 3*a0^2*a2^3*b2^3 - a0*a1^3*b2^4/2 - 10*a0*a1^2*a2^2*b2^3 - 8*a0*a1*a2^4*b2^2,a0^3*a2*b2^4/4 + 5*a0^2*a1^2*b2^4/4 + 7*a0^2*a1*a2^2*b2^3 - 4*a1^5*b2^3,a0^4*b2^4/4 + 3*a0^3*a1*a2*b2^3/2 + 8*a0^3*a2^3*b2^2 + a0^2*a1^3*b2^3 + 4*a0^2*a1^2*a2^2*b2^2 - 8*a0*a1^4*a2*b2^2,-a0^4*a2*b2^3/2 - 5*a0^3*a1^2*b2^3/2 - 14*a0^3*a1*a2^2*b2^2 + 8*a0*a1^5*b2^2,7*a0^2*a1*b2^4/4 - a0^2*a2^2*b2^3/2 + 4*a0*a1^2*a2*b2^3 + 4*a0*a1*a2^3*b2^2 + 2*a1^4*b2^3},{-7*a0*a1*b2^6/16 + 5*a0*a2^2*b2^5/8 - 5*a1^2*a2*b2^5/2 + 4*a2^5*b2^3,-3*a0*a1*a2*b2^5/4 - 3*a0*a2^3*b2^4/4 + 7*a1^3*b2^5/8 - a1^2*a2^2*b2^4 - 4*a1*a2^4*b2^3,7*a0^2*a1*b2^5/8 - 5*a0^2*a2^2*b2^4/4 + 5*a0*a1^2*a2*b2^4 - 8*a0*a2^5*b2^2,a0^2*a1*a2*b2^4/2 + 3*a0^2*a2^3*b2^3/2 + 13*a0*a1^3*b2^4/4 + 10*a0*a1^2*a2^2*b2^3 - 4*a1^4*a2*b2^3,-7*a0^3*a1*b2^4/4 + a0^3*a2^2*b2^3/2 + 16*a0^2*a1*a2^3*b2^2 - 8*a0*a1^3*a2^2*b2^2,-a0^3*a1*a2*b2^3 - 3*a0^3*a2^3*b2^2 - 13*a0^2*a1^3*b2^3/2 - 20*a0^2*a1^2*a2^2*b2^2 + 8*a0*a1^4*a2*b2^2,a0^2*a2*b2^4/2 - 5*a0*a1^2*b2^4/2 - 4*a0*a1*a2^2*b2^3 + 4*a0*a2^4*b2^2 + 2*a1^3*a2*b2^3},{-9*a0*a2*b2^6/16 + 5*a1^2*b2^6/16 - 5*a1*a2^2*b2^5/2 - 4*a2^4*b2^4,13*a0*a1*b2^6/16 + a0*a2^2*b2^5/8 + 7*a1^2*a2*b2^5/2 + 4*a1*a2^3*b2^4,9*a0^2*a2*b2^5/8 - 5*a0*a1^2*b2^5/8 + 5*a0*a1*a2^2*b2^4 + 8*a0*a2^4*b2^3,-9*a0^2*a1*b2^5/8 - a0^2*a2^2*b2^4/4 - 4*a0*a1^2*a2*b2^4 + 2*a1^4*b2^4,-5*a0^3*a2*b2^4/4 + 5*a0^2*a1^2*b2^4/4 - 4*a0^2*a1*a2^2*b2^3 + 4*a0*a1^3*a2*b2^3,9*a0^3*a1*b2^4/4 + a0^3*a2^2*b2^3/2 + 8*a0^2*a1^2*a2*b2^3 - 4*a0*a1^4*b2^3,-a0^2*b2^5/4 - 3*a0*a1*a2*b2^4/2 - 4*a0*a2^3*b2^3 - a1^3*b2^4},{3*a0*b2^7/32 + 15*a1*a2*b2^6/16 + 3*a2^3*b2^5/2,3*a0*a2*b2^6/16 - 11*a1^2*b2^6/16 - a1*a2^2*b2^5/2 + a2^4*b2^4,-3*a0^2*b2^6/16 - 15*a0*a1*a2*b2^5/8 - 3*a0*a2^3*b2^4,-3*a0^2*a2*b2^5/8 - 9*a0*a1^2*b2^5/8 - a0*a1*a2^2*b2^4 - 2*a0*a2^4*b2^3 - 5*a1^3*a2*b2^4 - 4*a1^2*a2^3*b2^3,3*a0^3*b2^5/8 - 5*a0^2*a1*a2*b2^4/4 + 2*a0^2*a2^3*b2^3 - 10*a0*a1^2*a2^2*b2^3 - 8*a0*a1*a2^4*b2^2,3*a0^3*a2*b2^4/4 + 9*a0^2*a1^2*b2^4/4 + 2*a0^2*a1*a2^2*b2^3 + 4*a0^2*a2^4*b2^2 + 10*a0*a1^3*a2*b2^3 + 8*a0*a1^2*a2^3*b2^2,5*a0*a1*b2^5/4 + a0*a2^2*b2^4 + 5*a1^2*a2*b2^4/2 + 2*a1*a2^3*b2^3},{-3*a1*b2^7/32 - 3*a2^2*b2^6/16,-3*a0*b2^7/32 - 9*a1*a2*b2^6/16 - 3*a2^3*b2^5/4,3*a0*a1*b2^6/16 + 3*a0*a2^2*b2^5/8,3*a0^2*b2^6/16 + 3*a0*a1*a2*b2^5/8 + 3*a0*a2^3*b2^4/2 + 5*a1^3*b2^5/4 - a1^2*a2^2*b2^4 - 4*a1*a2^4*b2^3,-3*a0^2*a1*b2^5/8 - 9*a0^2*a2^2*b2^4/4 + 5*a0*a1^2*a2*b2^4/2 - 2*a0*a1*a2^3*b2^3 - 8*a0*a2^5*b2^2,-3*a0^3*b2^5/8 - 3*a0^2*a1*a2*b2^4/4 - 3*a0^2*a2^3*b2^3 - 5*a0*a1^3*b2^4/2 + 2*a0*a1^2*a2^2*b2^3 + 8*a0*a1*a2^4*b2^2,3*a0*a2*b2^5/8 - 5*a1^2*b2^5/8 + a1*a2^2*b2^4/2 + 2*a2^4*b2^3},{0,3*a1*b2^7/32 + 3*a2^2*b2^6/16,0,3*a0*a1*b2^6/16 - 3*a0*a2^2*b2^5/8 + 9*a1^2*a2*b2^5/4 + 3*a1*a2^3*b2^4,3*a0^2*a2*b2^5/4 + 9*a0*a1*a2^2*b2^4/2 + 6*a0*a2^4*b2^3,-3*a0^2*a1*b2^5/8 + 3*a0^2*a2^2*b2^4/4 - 9*a0*a1^2*a2*b2^4/2 - 6*a0*a1*a2^3*b2^3,-3*a0*b2^6/16 - 9*a1*a2*b2^5/8 - 3*a2^3*b2^4/2},{0,0,0,-3*a1^2*b2^6/8 - 3*a1*a2^2*b2^5/4,-3*a0*a1*a2*b2^5/4 - 3*a0*a2^3*b2^4/2,3*a0*a1^2*b2^5/4 + 3*a0*a1*a2^2*b2^4/2,3*a1*b2^6/16 + 3*a2^2*b2^5/8}};
assert(rank M2jet == 3);
assert(rank(M2jet||M3jet) == 3);
assert(det(M2jet^{0,1,2}_{4,5,6}) == -a0^8);
assert(det(M2jet^{4,5,6}_{0,1,6}) == -b2^8/256);
print "UNIVERSAL QUARTIC CONTACT KERNEL VERIFIED: CUBIC TIMES LINEARS";
