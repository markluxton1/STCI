S=QQ[a0,a1,a2,q,b2,MonomialOrder=>GRevLex];
D=a0^2*b2^2 + 6*a0*a1*a2*b2 - a0*a1*b2*q + 4*a0*a2^3 - 4*a0*a2^2*q - 2*a0*a2*b2 + a0*a2*q^2 - 2*a1^3*b2 + 2*a1^2*a2*q + a1^2*b2 - 2*a1*a2^2 - a1*a2*q + a2^2;
M=matrix{{a0*a1*b2*q + a0*a2*b2 - a0*b2*q/2 + 2*a1^2*q^2 + 4*a1*a2*q - a1*b2 - 7*a1*q^2/2 + 2*a2^2 - 3*a2*q/2 + 5*b2/8 + 13*q^2/8,2*a0^2*a1*b2 + 4*a0*a1^2*q + 4*a0*a1*a2 - 5*a0*a1*q - 2*a0*a2 + 3*a0*q/2 - 2*a1^2 + 2*a1 - 1/2,-2*a0^2*a2 + a0^2*q + a0*a1 - a0/2,0,0,a0^2},{-a0*b2^2/4 - a0*b2*q^2/2 - a1*q^3/2 - 3*a2*q^2/2 + 3*b2*q/8 + q^3/4,-a0^2*b2*q/2 + 2*a0*a1*b2 - a0*a1*q^2 - 4*a0*a2*q - a0*b2/4 + a0*q^2/4 - 2*a1^2*q - 2*a1*a2 + 7*a1*q/2 + a2 - 5*q/4,a0^2*b2/2 + a0^2*q^2/2 + a0*a1*q - a0*a2 + a1/2 - 1/4,a0^3*q - a0^2/2,-a0^3,a0},{-a0*b2^2*q/4 - a2*q^3 + b2^2/8 - b2*q^2/8 + q^4/8,a0*a1*b2*q - a0*a2*b2 - 2*a0*a2*q^2 + a0*b2*q/2 + a0*q^3/4 + 2*a1*a2*q + a1*b2/2 + 2*a2^2 + b2/8 + q^2/8,a0^2*b2*q/2 + a0*a1*q^2 - a0*a2*q + a0*q^2/2 + a1*q - q/2,2*a0^2*a1*q + 2*a0^2*a2 - a0^2*q/2 - a0*a1,-a0^3*q - a0^2/2,a0*q + 1/4},{a1*b2^2*q/2 + a2*b2^2/2 - a2*b2*q^2 - b2^2*q/2 + b2*q^3/8,2*a0*a1*b2^2 - a0*a2*b2*q + a0*b2*q^2/4 + 2*a1^2*b2*q + 2*a1*a2*b2 - 2*a1*b2*q + 2*a2^2*q - a2*b2/2 - a2*q^2/2 + 9*b2*q/8 + q^3/8,a0*a1*b2*q - a0*a2*b2 + a0*a2*q^2 + a0*b2*q + 2*a1^2*q^2 + 4*a1*a2*q - a1*b2/2 - 5*a1*q^2/2 + 2*a2^2 - 3*a2*q/2 + b2/4 + 5*q^2/4,2*a0^2*a2*q + 4*a0*a1^2*q + 4*a0*a1*a2 - 4*a0*a1*q - a0*a2 + 3*a0*q/4 - 2*a1^2 + 3*a1/2 - 3/8,-2*a0^2*a1*q - 2*a0^2*a2 + 2*a0*a1 - 3*a0/4,a0*b2 + q/2},{-b2^3/8 - b2^2*q^2/8,-a0*b2^2*q/4 + a1*b2^2 - 3*a2*b2*q/2 - b2^2/8 + b2*q^2/4,a0*b2^2/4 + a1*b2*q/2 - a2*b2/2 - a2*q^2 + b2*q/4,a0^2*b2*q/2 - a0*a2*q - a0*b2/4 - 3*a0*q^2/4 - 2*a1^2*q - 2*a1*a2 + 3*a1*q + a2 - 9*q/8,-a0^2*b2/2 + a0^2*q^2/2 - a0*q/4 + a1 - 3/8,b2/2 + q^2/4},{-b2^3*q/8,a1*b2^2*q/2 - a2*b2^2/2 - a2*b2*q^2/2 + b2^2*q/8,a0*b2^2*q/4 + a1*b2*q^2/2 - a2*b2*q/2 - a2*q^3/2 + b2^2/8,a0*a1*b2*q + a0*a2*b2 - a0*a2*q^2 + 2*a1*a2*q - a1*b2/2 + 2*a2^2 + a2*q/2 + 3*b2/8,-a0^2*b2*q/2 - a0*b2/2 + 3*a0*q^2/4 + 3*a1*q/2 + a2/2 - 3*q/4,b2*q/2},{0,a1*b2^3/2 - a2*b2^2*q/2,a1*b2^2*q/2 - a2*b2*q^2/2,a0*a2*b2*q + a0*b2*q^2/4 + 2*a1^2*b2*q + 2*a1*a2*b2 - 5*a1*b2*q/2 + 2*a2^2*q + 9*b2*q/8,-a0*a1*b2*q - a0*a2*b2 + 2*a0*a2*q^2 + a0*b2*q/2 + a0*q^3/4 + 2*a1^2*q^2 + 4*a1*a2*q - 5*a1*q^2/2 + 2*a2^2 - a2*q/2 + 9*q^2/8,b2^2/4}};
J=minors(6,M,Strategy=>Dynamic);
print(numgens J);
apply(flatten entries gens J, f -> print factor f);
