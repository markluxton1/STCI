-- Small diagonal quotient calculation. No broad parameter elimination.
qqCheck=(label,condition)->(assert(condition);print("PASS "|label));
orig=QQ[delta,a,B,G,J,p,q];
F=value get "research/validation/2026-10-12-nonendpoint-diagonal-norm/20261012T212553449292Z/primitive-polynomial.txt";
Gs=-(6*B+delta^2-3*delta)*q-(3*a-3*B+2*delta)*q^2+2*a*q^3;
Js=(-Gs*(1+3*q)-(6*B+5*delta^2-3*delta)*q-(3*a+3*B+delta-delta^2)*q^2+(a+B)*q^3)/2;
firstDerivative=sub(diff(p,F),{G=>Gs,J=>Js,p=>q});
L1=3*(a*q+B)*(q-1)^2*(q^2-6*q+6)+delta*q*(3-2*q)*(q^2-6*q+6)-3*delta^2*(q-1)^2*(q-3);
L2=firstDerivative//(-delta*q*L1);
qqCheck("first derivative exact factor",firstDerivative==-delta*q*L1*L2);
param=QQ[dpar,apar,bpar,qpar];
paramField=frac param;
paramMap=map(paramField,orig,{dpar,apar,bpar,0_paramField,0_paramField,0_paramField,qpar});
d0=sub(dpar,paramField); av=sub(apar,paramField); bv=sub(bpar,paramField); qv=sub(qpar,paramField);
invq=1_paramField/qv; rho=d0*invq;
gv=paramMap Gs; jv=paramMap Js; factorOne=paramMap L1; factorTwo=paramMap L2;
quotientRing=paramField[rv,pv];
Z=gv*pv*(2-pv)+jv*(3-pv);
Ac=(3*d0^2+gv)*pv*(2-pv)+jv*(3-pv);
bc=d0*(d0^2*pv*(pv-3)+3*bv*pv*(2-pv)+gv*(2-pv)-jv);
cc=d0^2*(bv*pv*(pv-3)-gv);
Q2=Ac*rv^2+bc*rv+cc;
Nc=d0^2*(pv*rv-d0)*(3*(2-pv)*rv-d0*(3-pv));
Mc=d0^2*(3*jv*rv^2+d0*(2*gv-jv)*rv-d0^2*gv);
Psi=pv^2*Z^2*rv^4+pv^2*Z*(2*rv^2+rv-av)*Nc+pv^2*Nc^2-Mc*Z;
C3=Psi//(pv*rv-d0);
Qq=sub(Q2,{pv=>qv}); Cq=sub(C3,{pv=>qv});
LQ=Qq//(rv-rho); CQ=Cq//(rv-rho);
qqCheck("diagonal exact quotient pair",Qq==(rv-rho)*LQ and Cq==(rv-rho)*CQ);
AQ=lift(sub(Ac,{pv=>qv}),paramField);
lc=lift(coefficient(rv,LQ),paramField); lc0=lift(sub(LQ,{rv=>0}),paramField);
dc=lift(coefficient(rv^2,CQ),paramField); ec=lift(coefficient(rv,CQ),paramField); fc=lift(sub(CQ,{rv=>0}),paramField);
qqCheck("quotient leading coefficients",lc==AQ and dc==qv*AQ^2);
OffNorm=AQ*fc-lc0*ec+qv*AQ*lc0^2;
qqCheck("quotient fixed degree resultant factor",lift(resultant(LQ,CQ,rv),paramField)==AQ*OffNorm);

kappa=av*qv+bv; Pcollision=qv^2-6*qv+6; Pprimitive=qv^2-3*qv+3;
Uv=qv*(kappa-d0)-d0^2;
Sv=3*(kappa-d0)*(qv-1)*(qv-2)+d0^2*(3-2*qv);
qqCheck("normalized offdiagonal quotient norm",OffNorm==d0^2*qv^5*Uv^2*factorOne);
qqCheck("fiber denominator and quadratic leading coefficient",lift(sub(Z,{pv=>qv}),paramField)==qv*Pcollision*Uv and AQ==qv^2*((kappa-d0)*Pcollision+d0^2*(3-qv)));
LD=lift(sub(LQ,{rv=>rho}),paramField); CD=lift(sub(CQ,{rv=>rho}),paramField);
quadDiagonal=kk->(6*(kk-d0)^2*qv*(qv-1)*(qv-3)+d0*(kk-d0)*qv*Pcollision-4*d0^2*(kk-d0)*(2*qv^2-6*qv+3)-d0^3*Pcollision+3*d0^4*(qv-2));
qqCheck("both diagonal quotient values",LD==d0*qv*Sv and CD==qv^2*d0^2*Pcollision*quadDiagonal(kappa));
Wedge=lift(sub(diff(rv,Q2)*diff(pv,C3)-diff(pv,Q2)*diff(rv,C3),{rv=>rho,pv=>qv}),paramField);
qqCheck("second Taylor factor is actual diagonal wedge",Wedge==d0^5*Pcollision^2*factorTwo);
ks=d0+d0^2*(2*qv-3)/(3*(qv-1)*(qv-2));
Us=qv*(ks-d0)-d0^2;
As=qv^2*((ks-d0)*Pcollision+d0^2*(3-qv));
L1s=3*ks*(qv-1)^2*Pcollision+d0*qv*(3-2*qv)*Pcollision-3*d0^2*(qv-1)^2*(qv-3);
CDs=qv^2*d0^2*Pcollision*quadDiagonal(ks);
qqCheck("diagonal-exception substitution and retained denominators",3*(ks-d0)*(qv-1)*(qv-2)+d0^2*(3-2*qv)==0 and Us==-d0^2*Pcollision/(3*(qv-1)*(qv-2)) and As==-d0^2*qv^3*Pprimitive/(3*(qv-1)*(qv-2)));
qqCheck("first factor on diagonal exception",L1s==d0*Pprimitive*(Pcollision-d0*qv*(qv-1)/(qv-2)));
qqCheck("second quotient value retains primitive-root degree drop",CDs==d0^5*qv^2*Pcollision^2/(3*(qv-1)*(qv-2)^2)*(d0*qv*(qv-1)-Pcollision*(qv-2)));
print "PASS all eleven exact small quotient identities";
