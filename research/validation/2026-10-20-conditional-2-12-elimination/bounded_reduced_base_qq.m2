smoothDiscriminant=(4*compactInvI^3-compactInvJ^2)/27;
baseIdeal=ideal join(firstEquations,symbolEquations,{smoothInverse*smoothDiscriminant-1});
print "COMPACT_BASE_MODEL_READY";
G=gb baseIdeal;
print "BASE_GB_COMPLETE";
