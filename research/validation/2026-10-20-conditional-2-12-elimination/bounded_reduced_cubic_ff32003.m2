cubicEquations=select(flatten apply(syzygyPolynomials,p->apply(14,j->coeffR(p,j))),p->p!=0);
cubicIdeal=baseIdeal+ideal cubicEquations;
print("COMPACT_CUBIC_EQUATIONS="|toString(#cubicEquations));
