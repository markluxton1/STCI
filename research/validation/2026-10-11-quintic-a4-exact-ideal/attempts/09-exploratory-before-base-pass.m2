R = QQ[z0,z1,z2,z3,z4,z5];
T = QQ[x,y,z];
parametrization = {y*z^2-x^3,x*y*z,y^2*z,x^2*y,x*y^2,y^3};
phi = map(T,R,parametrization);
I = ker phi;
print("IDEAL " | toString gens I);
print("DIM " | toString dim(R/I));
print("DEGREE " | toString degree(R/I));
print("HS " | toString hilbertSeries(R/I));
print("HP " | toString hilbertPolynomial(R/I));
print("BETTI " | toString betti res coker gens I);
J = saturate(I+minors(3,jacobian I),ideal vars R);
print("SING " | toString gens J);
print("SINGDIM " | toString dim(R/J));
print("SINGDEG " | toString degree(R/J));
print("RADICAL " | toString gens radical J);
Eline = ideal(z2,z3,z4,z5);
B = QQ[s,t];
quarticParametrization = {t^4-s*t^3,-s*t^3,-s^2*t^2,s^2*t^2,s^3*t,s^4};
curveMap = map(B,R,quarticParametrization);
Ic = ker curveMap;
print("CURVE IDEAL " | toString gens Ic);
print("CURVE DEG " | toString degree(R/Ic));
print("HYPERPLANE SPLIT " | toString (trim intersect(Ic,Eline) == trim(I+ideal(z2+z3))));
print("CURVE LINE MEET " | toString gens saturate(Ic+Eline,ideal vars R));
print("CURVE LINE MEET DEG " | toString degree(R/(Ic+Eline)));
exit 0;
