-- Independent Type2/3 audit in alternative algebraic branch coordinates.
-- Type2 epsilon^2=3, x=(epsilon+3)/6.
-- Type3 theta^2=3,zeta^2=6, tau=(theta+3)/6,x=(theta+zeta+3)/6.
type23CheckCount=0;
type23Assert=(label,value)->(assert value; type23CheckCount=type23CheckCount+1; print("PASS "|toString type23CheckCount|": "|label));
type23Sections=(r,t,delta,a,b,g,d)->(
    x0=r^4-(2*r^2+r)*t+t^2+a*t;
    x1=x0-delta*(r^3-r*t)+(b-a)*t;
    x2=x0-3*delta*(r^3-r*t)+3*delta^2*r^2-delta^3*r+(g-a)*t;
    x3=x0-4*delta*(r^3-r*t)+6*delta^2*r^2-4*delta^3*r+delta^4+(d-a)*t;
    {x0,x1,x2,x3});
-- Each coordinate below is exactly q^4*Xi(1/q,W/q^2).
type23InfinitySections=(q,W,delta,a,b,g,d)->(
    x0=1-2*W+W^2-q*W+a*q^2*W;
    x1=x0-delta*q*(1-W)+(b-a)*q^2*W;
    x2=x0-3*delta*q*(1-W)+3*delta^2*q^2-delta^3*q^3+(g-a)*q^2*W;
    x3=x0-4*delta*q*(1-W)+6*delta^2*q^2-4*delta^3*q^3+delta^4*q^4+(d-a)*q^2*W;
    {x0,x1,x2,x3});

-- Type 2: all algebraic branches in one reduced coefficient algebra.
s2base=QQ[s2r,s2delta,s2theta];
s2ring=s2base/ideal(s2theta^2-3);
s2tau=1/2; s2x=(s2theta+3)/6;
s2u=s2x*s2delta^2; s2w=3*s2u;
s2a=2*s2u+(s2delta-s2delta^2)/2;
s2b=s2a-s2u; s2g=s2a-s2w; s2d=s2a-s2u-s2w;
s2rho=s2tau*s2delta;
s2tauInv=2;
type23Assert("Type2 tau unit",s2tau*s2tauInv==1);
s2j=(6*s2u)*s2delta-3*s2delta^3;
type23Assert("Type2 j has no discarded nonzero-delta root",s2j==s2theta*s2delta^3 and s2theta^2==3);
s2p2=-s2u*s2w+(3*s2a+3*s2u)*s2delta^2+3*s2delta^3;
s2middle=-(s2p2-3*s2delta^2*s2rho);
s2constant=s2a*s2tauInv*s2delta^3;
s2tNum=3*s2delta^2*s2r^2+s2middle*s2r+s2constant;
s2TNum=s2tNum+s2j*s2r^2;
s2fResidual=-3*s2delta^2*s2r^3+s2p2*s2r^2+((-3*s2a-s2u)*s2delta^3-s2delta^4)*s2r+s2a*s2delta^4;
type23Assert("Type2 conic coefficient",s2j*s2rho-s2u*s2w+s2delta^4==0);
type23Assert("Type2 full residual factor",s2fResidual==-(s2r-s2rho)*s2tNum);
type23Assert("Type2 Jbar zero",s2d-2*s2g+2*s2b-s2a==0);
s2L0=s2a-2*s2r^2-s2r;
s2L1=s2b-2*s2r^2-s2r+s2delta*s2r;
s2L2=s2g-2*s2r^2-s2r+3*s2delta*s2r;
s2L3=s2d-2*s2r^2-s2r+4*s2delta*s2r;
s2P=s2r^3*s2L2-3*s2r*(s2r-s2delta)^2*s2L1+2*(s2r-s2delta)^3*s2L0;
s2J=2*s2r^3*s2L3-3*s2r^2*(s2r-s2delta)*s2L2+(s2r-s2delta)^3*s2L1;
type23Assert("Type2 P degree at most two",diff(s2r,diff(s2r,diff(s2r,s2P)))==0);
type23Assert("Type2 J degree at most two",diff(s2r,diff(s2r,diff(s2r,s2J)))==0);
type23Assert("Type2 two leading terms never both vanish",sub(diff(s2r,diff(s2r,s2J-s2P)),{s2r=>0})/2==4*s2delta^3);
s2incidence=saturate(ideal(s2P,s2J,s2TNum),ideal s2delta);
type23Assert("Type2 r=0 is not omitted",saturate(s2incidence,ideal s2r)==s2incidence);
type23Assert("Type2 complete exact incidence",s2incidence==ideal(5*(s2delta+s2theta)^2*(s2delta+s2theta/5),4*s2r-(s2theta+2)*s2delta-1));

type23Assert("Type2 finite incidence scheme length6",dim(s2ring/s2incidence)==0 and degree(s2ring/s2incidence)==6);
s2exprs={s2r,s2delta,s2a,s2b,s2g,s2d,s2j,s2middle,s2constant,s2P,s2J,s2TNum,s2theta};
s2jetbase=s2ring[s2jet,s2invD,s2invJ];
s2lift=(v)->sub(v,s2jetbase);
s2relations=ideal(s2lift(s2P),s2lift(s2J),s2lift(s2TNum),s2lift(s2delta)*s2invD-1,s2lift(s2j)*s2invJ-1);
s2sourceJet=s2jet; s2sourceInvJ=s2invJ;
s2jets=s2jetbase/s2relations;
s2toJet=(v)->sub(v,s2jets);
s2q=s2toJet(s2sourceJet);
s2v=apply(s2exprs,s2toJet);
s2rr=s2v#0+s2q; s2dd=s2v#1;
s2tt=((s2v#6+3*s2dd^2)*s2rr^2+s2v#7*s2rr+s2v#8)*s2toJet(s2sourceInvJ);
s2sections=type23Sections(s2rr,s2tt,s2dd,s2v#2,s2v#3,s2v#4,s2v#5);
type23Assert("Type2 finite incidence algebra nonzero",ideal(0_s2jets)!=ideal(1_s2jets));
type23Assert("Type2 finite actual Q equation",s2sections#0*s2sections#3-s2sections#1*s2sections#2==0);
type23Assert("Type2 finite intrinsic contact",sub(s2tt,{s2q=>0})==0);
type23Assert("Type2 finite X0 unit",ideal(sub(s2sections#0,{s2q=>0}))==ideal(1_s2jets));
s2contact=(s2sections#0)^2*s2sections#2-(s2sections#1)^3;
s2c0=sub(s2contact,{s2q=>0});
s2c1=sub(diff(s2q,s2contact),{s2q=>0});
s2c2=sub(diff(s2q,diff(s2q,s2contact)),{s2q=>0})/2;
s2c3=sub(diff(s2q,diff(s2q,diff(s2q,s2contact))),{s2q=>0})/6;
type23Assert("Type2 finite constant coefficient zero",s2c0==0);
type23Assert("Type2 finite linear coefficient zero",s2c1==0);
type23Assert("Type2 full joint second/third coefficient ideal",ideal(s2c2,s2c3)==ideal(1_s2jets));
type23Assert("Type2 exact second-coefficient degeneration",ideal(s2c2)==ideal(s2v#1+s2v#12));
s2intrinsicFirst=sub(diff(s2q,s2tt),{s2q=>0});
type23Assert("Type2 intrinsic first coefficient unit on degeneration",ideal(s2c2,s2intrinsicFirst)==ideal(1_s2jets));
print "Type2 second coefficient is a unit on complete incidence:"; print(ideal(s2c2)==ideal(1_s2jets));

-- Separate full delta-open infinity algebra, no finite-incidence relation.
s2infbase=s2ring[s2infJet,s2infInvD,s2infInvJ];
s2liftInf=(v)->sub(v,s2infbase);
s2infRelations=ideal(s2liftInf(s2exprs#1)*s2infInvD-1,s2liftInf(s2exprs#6)*s2infInvJ-1);
s2infSourceJet=s2infJet; s2infSourceInvJ=s2infInvJ;
s2infinity=s2infbase/s2infRelations;
type23Assert("Type2 full delta-open infinity algebra nonzero",ideal(0_s2infinity)!=ideal(1_s2infinity));
s2toInf=(v)->sub(v,s2infinity);
s2iq=s2toInf(s2infSourceJet); s2iv=apply(s2exprs,s2toInf);
s2W=(3*s2iv#1^2+s2iv#7*s2iq+s2iv#8*s2iq^2+s2iv#6)*s2toInf(s2infSourceInvJ);
s2infSec=type23InfinitySections(s2iq,s2W,s2iv#1,s2iv#2,s2iv#3,s2iv#4,s2iv#5);
type23Assert("Type2 infinity actual Q equation",s2infSec#0*s2infSec#3-s2infSec#1*s2infSec#2==0);
type23Assert("Type2 infinity X0 unit",sub(s2infSec#0,{s2iq=>0})*(s2iv#6)^2==9*(s2iv#1)^4);
s2infContact=(s2infSec#0)^2*s2infSec#2-(s2infSec#1)^3;
s2b0=sub(s2infContact,{s2iq=>0});
s2b1=sub(diff(s2iq,s2infContact),{s2iq=>0});
s2b2=sub(diff(s2iq,diff(s2iq,s2infContact)),{s2iq=>0})/2;
s2b3=sub(diff(s2iq,diff(s2iq,diff(s2iq,s2infContact))),{s2iq=>0})/6;
s2b4=sub(diff(s2iq,diff(s2iq,diff(s2iq,diff(s2iq,s2infContact)))),{s2iq=>0})/24;
type23Assert("Type2 infinity coefficients 0,1,2 vanish",s2b0==0 and s2b1==0 and s2b2==0);
s2drop=s2iv#6+3*(s2iv#1)^2;
type23Assert("Type2 complete infinity degree-drop stratum",ideal(s2drop)==ideal(s2iv#1+s2iv#12));
type23Assert("Type2 infinity cubic coefficient identity",s2b3*(s2iv#6)^4==54*(s2iv#1)^9*s2drop);
type23Assert("Type2 no T degree-zero stratum",ideal(s2drop,s2iv#7)==ideal(1_s2infinity));
type23Assert("Type2 infinity quartic coefficient on degree drop",(s2b4*s2iv#6+2*(s2iv#1)^3*s2iv#7) % ideal(s2drop)==0);
type23Assert("Type2 infinity quartic coefficient unit on drop",ideal(s2drop,s2b4)==ideal(1_s2infinity));

-- Type 3: all algebraic branches in one reduced coefficient algebra.
s3base=QQ[s3r,s3delta,s3theta,s3zeta];
s3ring=s3base/ideal(s3theta^2-3,s3zeta^2-6);
s3tau=(s3theta+3)/6; s3x=(s3theta+s3zeta+3)/6;
s3u=s3x*s3delta^2; s3w=3*s3u;
s3a=(6*s3tau-1)*s3u+s3tau*s3delta-(3*s3tau-2/3)*s3delta^2;
s3b=s3a-s3u; s3g=s3a-s3w; s3d=s3a-s3u-s3w;
s3rho=s3tau*s3delta;
s3tauInv=6*(1-s3tau);
type23Assert("Type3 tau unit",s3tau*s3tauInv==1);
s3j=(6*s3u)*s3delta-3*s3delta^3;
type23Assert("Type3 j has no discarded nonzero-delta root",s3j== (s3theta+s3zeta)*s3delta^3 and (s3theta+s3zeta)*(s3theta-s3zeta)==-3);
s3p2=-s3u*s3w+(3*s3a+3*s3u)*s3delta^2+3*s3delta^3;
s3middle=-(s3p2-3*s3delta^2*s3rho);
s3constant=s3a*s3tauInv*s3delta^3;
s3tNum=3*s3delta^2*s3r^2+s3middle*s3r+s3constant;
s3TNum=s3tNum+s3j*s3r^2;
s3fResidual=-3*s3delta^2*s3r^3+s3p2*s3r^2+((-3*s3a-s3u)*s3delta^3-s3delta^4)*s3r+s3a*s3delta^4;
type23Assert("Type3 conic coefficient",s3j*s3rho-s3u*s3w+s3delta^4==0);
type23Assert("Type3 full residual factor",s3fResidual==-(s3r-s3rho)*s3tNum);
type23Assert("Type3 Jbar zero",s3d-2*s3g+2*s3b-s3a==0);
s3L0=s3a-2*s3r^2-s3r;
s3L1=s3b-2*s3r^2-s3r+s3delta*s3r;
s3L2=s3g-2*s3r^2-s3r+3*s3delta*s3r;
s3L3=s3d-2*s3r^2-s3r+4*s3delta*s3r;
s3P=s3r^3*s3L2-3*s3r*(s3r-s3delta)^2*s3L1+2*(s3r-s3delta)^3*s3L0;
s3J=2*s3r^3*s3L3-3*s3r^2*(s3r-s3delta)*s3L2+(s3r-s3delta)^3*s3L1;
type23Assert("Type3 P degree at most two",diff(s3r,diff(s3r,diff(s3r,s3P)))==0);
type23Assert("Type3 J degree at most two",diff(s3r,diff(s3r,diff(s3r,s3J)))==0);
type23Assert("Type3 two leading terms never both vanish",sub(diff(s3r,diff(s3r,s3J-s3P)),{s3r=>0})/2==4*s3delta^3);
s3incidence=saturate(ideal(s3P,s3J,s3TNum),ideal s3delta);
type23Assert("Type3 r=0 is not omitted",saturate(s3incidence,ideal s3r)==s3incidence);
s3parameter=s3delta^2+(2*s3theta+4*s3zeta)/3*s3delta+1;
type23Assert("Type3 parameter relation on full incidence",s3parameter % s3incidence==0);

s3polyIncidence=lift(s3incidence,s3base)+ideal(s3base_2^2-3,s3base_3^2-6);
s3parameterIdeal=sub(eliminate(s3polyIncidence,{s3base_0}),s3ring);
type23Assert("Type3 exact parameter eliminated ideal",s3parameterIdeal==ideal(s3parameter));
type23Assert("Type3 finite incidence scheme length12",dim(s3ring/s3incidence)==0 and degree(s3ring/s3incidence)==12);
s3exprs={s3r,s3delta,s3a,s3b,s3g,s3d,s3j,s3middle,s3constant,s3P,s3J,s3TNum,s3theta,s3zeta};
s3jetbase=s3ring[s3jet,s3invD,s3invJ];
s3lift=(v)->sub(v,s3jetbase);
s3relations=ideal(s3lift(s3P),s3lift(s3J),s3lift(s3TNum),s3lift(s3delta)*s3invD-1,s3lift(s3j)*s3invJ-1);
s3sourceJet=s3jet; s3sourceInvJ=s3invJ;
s3jets=s3jetbase/s3relations;
s3toJet=(v)->sub(v,s3jets);
s3q=s3toJet(s3sourceJet);
s3v=apply(s3exprs,s3toJet);
s3rr=s3v#0+s3q; s3dd=s3v#1;
s3tt=((s3v#6+3*s3dd^2)*s3rr^2+s3v#7*s3rr+s3v#8)*s3toJet(s3sourceInvJ);
s3sections=type23Sections(s3rr,s3tt,s3dd,s3v#2,s3v#3,s3v#4,s3v#5);
type23Assert("Type3 finite incidence algebra nonzero",ideal(0_s3jets)!=ideal(1_s3jets));
type23Assert("Type3 finite actual Q equation",s3sections#0*s3sections#3-s3sections#1*s3sections#2==0);
type23Assert("Type3 finite intrinsic contact",sub(s3tt,{s3q=>0})==0);
type23Assert("Type3 finite X0 unit",ideal(sub(s3sections#0,{s3q=>0}))==ideal(1_s3jets));
s3contact=(s3sections#0)^2*s3sections#2-(s3sections#1)^3;
s3c0=sub(s3contact,{s3q=>0});
s3c1=sub(diff(s3q,s3contact),{s3q=>0});
s3c2=sub(diff(s3q,diff(s3q,s3contact)),{s3q=>0})/2;
s3c3=sub(diff(s3q,diff(s3q,diff(s3q,s3contact))),{s3q=>0})/6;
type23Assert("Type3 finite constant coefficient zero",s3c0==0);
type23Assert("Type3 finite linear coefficient zero",s3c1==0);
type23Assert("Type3 full joint second/third coefficient ideal",ideal(s3c2,s3c3)==ideal(1_s3jets));
type23Assert("Type3 second coefficient unit on all incidence",ideal(s3c2)==ideal(1_s3jets));
print "Type3 second coefficient is a unit on complete incidence:"; print(ideal(s3c2)==ideal(1_s3jets));

-- Separate full delta-open infinity algebra, no finite-incidence relation.
s3infbase=s3ring[s3infJet,s3infInvD,s3infInvJ];
s3liftInf=(v)->sub(v,s3infbase);
s3infRelations=ideal(s3liftInf(s3exprs#1)*s3infInvD-1,s3liftInf(s3exprs#6)*s3infInvJ-1);
s3infSourceJet=s3infJet; s3infSourceInvJ=s3infInvJ;
s3infinity=s3infbase/s3infRelations;
type23Assert("Type3 full delta-open infinity algebra nonzero",ideal(0_s3infinity)!=ideal(1_s3infinity));
s3toInf=(v)->sub(v,s3infinity);
s3iq=s3toInf(s3infSourceJet); s3iv=apply(s3exprs,s3toInf);
s3W=(3*s3iv#1^2+s3iv#7*s3iq+s3iv#8*s3iq^2+s3iv#6)*s3toInf(s3infSourceInvJ);
s3infSec=type23InfinitySections(s3iq,s3W,s3iv#1,s3iv#2,s3iv#3,s3iv#4,s3iv#5);
type23Assert("Type3 infinity actual Q equation",s3infSec#0*s3infSec#3-s3infSec#1*s3infSec#2==0);
type23Assert("Type3 infinity X0 unit",sub(s3infSec#0,{s3iq=>0})*(s3iv#6)^2==9*(s3iv#1)^4);
s3infContact=(s3infSec#0)^2*s3infSec#2-(s3infSec#1)^3;
s3b0=sub(s3infContact,{s3iq=>0});
s3b1=sub(diff(s3iq,s3infContact),{s3iq=>0});
s3b2=sub(diff(s3iq,diff(s3iq,s3infContact)),{s3iq=>0})/2;
s3b3=sub(diff(s3iq,diff(s3iq,diff(s3iq,s3infContact))),{s3iq=>0})/6;
s3b4=sub(diff(s3iq,diff(s3iq,diff(s3iq,diff(s3iq,s3infContact)))),{s3iq=>0})/24;
type23Assert("Type3 infinity coefficients 0,1,2 vanish",s3b0==0 and s3b1==0 and s3b2==0);
s3drop=s3iv#6+3*(s3iv#1)^2;
type23Assert("Type3 complete infinity degree-drop stratum",ideal(s3drop)==ideal(s3iv#1+s3iv#13-s3iv#12));
type23Assert("Type3 infinity cubic coefficient identity",s3b3*(s3iv#6)^4==54*(s3iv#1)^9*s3drop);
type23Assert("Type3 no T degree-zero stratum",ideal(s3drop,s3iv#7)==ideal(1_s3infinity));
type23Assert("Type3 infinity quartic coefficient on degree drop",(s3b4*s3iv#6+2*(s3iv#1)^3*s3iv#7) % ideal(s3drop)==0);
type23Assert("Type3 infinity quartic coefficient unit on drop",ideal(s3drop,s3b4)==ideal(1_s3infinity));
print("TOTAL PASS CONDITIONS: "|toString type23CheckCount);
