orig=QQ[delta,a,B,G,J,p,q];
F=value get "research/validation/2026-10-12-nonendpoint-diagonal-norm/20261012T212553449292Z/primitive-polynomial.txt";
param=QQ[deltaPar,qPar,doublePar]; KK=frac param; ss=KK[rr,TT,pp,tt];
d0=sub(deltaPar,ss); q0=sub(qPar,ss); dv=sub(doublePar,ss);
bv=(dv-d0^2)/q0; av=d0/q0+2*d0^2/q0^2-dv/q0^2;
gv=-(3-q0)*dv; jv=q0*(2-q0)*dv;
fm=map(ss,orig,{d0,av,bv,gv,jv,pp,q0}); FS=fm F;
check=(label,x)->(assert(x);print("PASS "|label));
Fshift=sub(FS,{pp=>q0+tt});
check("F vanishes at specified common root",sub(Fshift,{tt=>0})==0);
scan(1..8,nn->(cn=lift(coefficient(tt^nn,Fshift),KK);print("TAYLOR "|toString nn|": "|toString factor numerator cn|" / "|toString factor denominator cn)));
Pc=q0^2-6*q0+6; P6=q0^2-3*q0+3;
A2=((3*d0^2+gv)*q0*(2-q0)+jv*(3-q0))*rr^2+d0*(d0^2*q0*(q0-3)+3*bv*q0*(2-q0)+gv*(2-q0)-jv)*rr+d0^2*(bv*q0*(q0-3)-gv);
check("compatibility quadratic factors on U zero",A2==d0^2*q0*(rr-d0/q0)*(3*(2-q0)*rr-(3-q0)*d0));
rs=d0*(3-q0)/(3*(2-q0)); Ts=d0^2*P6/(9*(2-q0)^2);
H12=gv+q0*(3-q0)*(d0*rr+bv); H13=jv-q0^2*(2-q0)*(d0*rr+bv);
R2=-d0*rr*(q0*rr-d0)*((3-q0)*rr-d0); R3=d0*(q0*rr-d0)*(q0*(2-q0)*rr^2+d0*(2-q0)*rr-d0^2);
check("offdiagonal linear target equations",sub(H12*TT+R2,{rr=>rs,TT=>Ts})==0 and sub(H13*TT+R3,{rr=>rs,TT=>Ts})==0);
J0=q0*TT^2+(d0*rr+bv-q0*(2*rr^2+rr-av))*TT+rr^3*(q0*rr-d0);
E=lift(sub(J0,{rr=>rs,TT=>Ts}),KK);
print("J0 offdiagonal: "|toString factor numerator E|" / "|toString factor denominator E);
print "PASS all U zero probe identities";
