load "research/validation/2026-10-13-evening-u-zero-subaudit/probe-final.m2";
Pcparam=qPar^2-6*qPar+6;
u1num=numerator lift(coefficient(tt^2,Fshift),KK);
u1den=denominator lift(coefficient(tt^2,Fshift),KK);
print("PcU numerator "|toString factor (u1num % Pcparam));
print("PcU denominator "|toString u1den);
u1Pc=lift(coefficient(tt^2,Fshift),KK);
upred=-9*d0^8*(q0-1)^4/q0^2;
uerr=lift(u1Pc-upred,KK);
uZeroCheck("Pc U exact second coefficient",numerator uerr % Pcparam==0);
load "research/validation/2026-10-13-evening-u-zero-subaudit/q-two-probe-final.m2";
twoFcofactor=Ftwo//(pp^2*(pp-2));
Rcond=16*dPar^4-24*dPar^2*twoD-12*dPar^2+9*twoD^2+8*twoD;
Econd=4*dPar^2+2*dPar-3*twoD;
baseTwo=frac param; twoRing=baseTwo[ps];
rsval=(8*sub(dPar,baseTwo)^2-6*sub(twoD,baseTwo))/(4*sub(dPar,baseTwo)^2+2*sub(dPar,baseTwo)-3*sub(twoD,baseTwo));
mapTwo=map(twoRing,outRing,{sub(dPar,baseTwo),sub(twoD,baseTwo),ps,0_twoRing});
Htwo=mapTwo twoFcofactor;
scan(0..4,nn->(df=Htwo;for jj from 1 to nn do df=diff(ps,df); vv=lift(sub(df,{ps=>rsval}),baseTwo); print("COFACTOR derivative "|toString nn|" remR="|toString factor (numerator vv % Rcond)); ("/private/tmp/Uzero-two-root-num"|toString nn|".txt")<<toString numerator vv<<close));
print "PASS pc intersection and two root probe completed";
