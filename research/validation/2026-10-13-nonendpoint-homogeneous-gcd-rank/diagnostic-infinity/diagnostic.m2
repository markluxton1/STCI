-- Literal identities supporting the independent homogeneous-gcd audit.
-- Matrix rank classification is a written UFD/Bezout proof, not inferred
-- from this identity checker or numerical samples.
RankAuditRing=QQ[rkDel,rkA,rkB,rkG,rkD,rkK,rkR,rkZ,rkU,rkV,rkS,rkT,rkP0,rkP1,rkP2,rkP3,rkJ0,rkJ1,rkJ2,rkJ3,rkH0,rkH1,rkH2,rkL0,rkL1,rkM0,rkM1];
rankAuditChecks=0;
rankAuditCheck=(label,condition)->(
  if not condition then error("FAIL "|label);
  rankAuditChecks=rankAuditChecks+1;
  print("PASS "|label);
);
rankLiteralP=(rkG-3*rkB+2*rkA)*rkR^3+(6*rkDel*(rkB-rkA)+rkDel^3-3*rkDel^2)*rkR^2+(rkDel^2*(6*rkA-3*rkB)+2*rkDel^3)*rkR-2*rkA*rkDel^3;
rankLiteralJ=(2*rkD-3*rkG+rkB)*rkR^3+(3*rkDel*(rkG-rkB)+5*rkDel^3-3*rkDel^2)*rkR^2+(3*rkB*rkDel^2+rkDel^3-rkDel^4)*rkR-rkB*rkDel^3;
rankScaledP=(rkG-3*rkB+2*rkA)*rkZ^3+(6*(rkB-rkA)+rkDel^2-3*rkDel)*rkZ^2+(6*rkA-3*rkB+2*rkDel)*rkZ-2*rkA;
rankScaledJ=(2*rkD-3*rkG+rkB)*rkZ^3+(3*(rkG-rkB)+5*rkDel^2-3*rkDel)*rkZ^2+(3*rkB+rkDel-rkDel^2)*rkZ-rkB;
rankAuditCheck("literal P scaling",sub(rankLiteralP,{rkR=>rkDel*rkZ})==rkDel^3*rankScaledP);
rankAuditCheck("literal J scaling",sub(rankLiteralJ,{rkR=>rkDel*rkZ})==rkDel^3*rankScaledJ);
rankAuditCheck("correct zero-P stratum",sub(rankScaledP,{rkDel=>-1,rkA=>0,rkB=>-2/3,rkG=>-2})==0);
rankAuditCheck("other cubic nonzero on zero-P stratum",sub(rankScaledJ,{rkDel=>-1,rkA=>0,rkB=>-2/3,rkG=>-2})==(2*rkD+16/3)*rkZ^3+4*rkZ^2-4*rkZ+2/3);
rankAuditCheck("correct zero-J stratum",sub(rankScaledJ,{rkDel=>1,rkB=>0,rkG=>-2/3,rkD=>-1})==0);
rankAuditCheck("other cubic on zero-J stratum",sub(rankScaledP,{rkDel=>1,rkB=>0,rkG=>-2/3,rkD=>-1})==(2*rkA-2/3)*rkZ^3+(-6*rkA-2)*rkZ^2+(6*rkA+2)*rkZ-2*rkA);
rankPropG=4*rkK^2*rkA+(rkK-5)*rkDel^2/3+(1-rkK)*rkDel;
rankPropD=(rkK+3)*rankPropG/2-3*rkK^2*rkA;
rankPropBindings={rkB=>2*rkK*rkA,rkG=>rankPropG,rkD=>rankPropD};
rankPropRelation=rkDel*(rkDel+2*rkK-1)-6*rkK^2*rkA;
rankAuditCheck("complete proportional-family literal identity",sub(rankScaledJ-rkK*rankScaledP,rankPropBindings)==-rankPropRelation*rkZ);
rankW01=rkP0*rkJ1-rkP1*rkJ0;
rankW02=rkP0*rkJ2-rkP2*rkJ0;
rankW03=rkP0*rkJ3-rkP3*rkJ0;
rankW12=rkP1*rkJ2-rkP2*rkJ1;
rankW13=rkP1*rkJ3-rkP3*rkJ1;
rankW23=rkP2*rkJ3-rkP3*rkJ2;
rankBezout=matrix{{rankW01,rankW02,rankW03},{rankW02,rankW03+rankW12,rankW13},{rankW03,rankW13,rankW23}};
rankPUV=rkP0*rkU^3+rkP1*rkU^2*rkV+rkP2*rkU*rkV^2+rkP3*rkV^3;
rankJUV=rkJ0*rkU^3+rkJ1*rkU^2*rkV+rkJ2*rkU*rkV^2+rkJ3*rkV^3;
rankPST=sub(rankPUV,{rkU=>rkS,rkV=>rkT});
rankJST=sub(rankJUV,{rkU=>rkS,rkV=>rkT});
rankBiform=(matrix{{rkU^2,rkU*rkV,rkV^2}}*rankBezout*transpose matrix{{rkS^2,rkS*rkT,rkT^2}})_(0,0);
rankAuditCheck("universal homogeneous Bezout identity",rankPUV*rankJST-rankJUV*rankPST==(rkU*rkT-rkV*rkS)*rankBiform);
rankAuditCheck("Plucker identity for six-minor criterion",rankW01*rankW23-rankW02*rankW13+rankW03*rankW12==0);
rankHUV=rkH0*rkU^2+rkH1*rkU*rkV+rkH2*rkV^2;
rankFactoredP=rankHUV*(rkL0*rkU+rkL1*rkV);
rankFactoredJ=rankHUV*(rkM0*rkU+rkM1*rkV);
rankFactorBindings={rkP0=>rkH0*rkL0,rkP1=>rkH0*rkL1+rkH1*rkL0,rkP2=>rkH1*rkL1+rkH2*rkL0,rkP3=>rkH2*rkL1,rkJ0=>rkH0*rkM0,rkJ1=>rkH0*rkM1+rkH1*rkM0,rkJ2=>rkH1*rkM1+rkH2*rkM0,rkJ3=>rkH2*rkM1};
rankFactorVector=matrix{{rkH0},{rkH1},{rkH2}};
rankAuditCheck("quadratic-gcd column recovery identity",sub(rankBezout,rankFactorBindings)==(rkL0*rkM1-rkL1*rkM0)*rankFactorVector*transpose rankFactorVector);
rankSyzygy=matrix{{rkP0,0,rkJ0,0},{rkP1,rkP0,rkJ1,rkJ0},{rkP2,rkP1,rkJ2,rkJ1},{rkP3,rkP2,rkJ3,rkJ2},{0,rkP3,0,rkJ3}};
rankAuditCheck("linear syzygy cofactor identity",sub(rankSyzygy,rankFactorBindings)*matrix{{rkM0},{rkM1},{-rkL0},{-rkL1}}==0);
rankInfinityBindings={rkP0=>0,rkP1=>0,rkP2=>1,rkP3=>0,rkJ0=>0,rkJ1=>0,rkJ2=>0,rkJ3=>1};
print sub(rankBezout,rankInfinityBindings);
print flatten entries sub(rankBezout,rankInfinityBindings);
print apply(flatten entries sub(rankBezout,rankInfinityBindings),item->item==0);
