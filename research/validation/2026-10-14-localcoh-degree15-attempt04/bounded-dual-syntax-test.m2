K=QQ;q=3;p=4;
A=matrix{{1_K,0_K,0_K},{0_K,2_K,0_K},{0_K,0_K,3_K}};
B=matrix{{1_K,2_K,3_K},{0_K,1_K,2_K},{1_K,3_K,5_K},{2_K,5_K,8_K}};
v=matrix{{1_K},{0_K},{0_K}};w=matrix{{0_K},{0_K},{0_K},{0_K}};
pivotRows={0,1};pivotColumns={0,1};missingColumn=2;
chosenBlock=matrix apply(pivotRows,ii->apply(pivotColumns,jj->B_(ii,jj)));
chosenInverse=id_(K^2)//chosenBlock;
assert(chosenBlock*chosenInverse==id_(K^2));
D=matrix apply(toList(0..q-1),ii->apply(toList(0..p-1),jj->if member(ii,pivotColumns) and member(jj,pivotRows) then chosenInverse_(position(pivotColumns,kk->kk==ii),position(pivotRows,kk->kk==jj)) else 0_K));
DB=D*B;
h=matrix apply(toList(0..q-1),ii->{(if ii==missingColumn then 1_K else 0_K)-DB_(ii,missingColumn)});
eMissing=matrix{apply(q,ii->if ii==missingColumn then 1_K else 0_K)};
assert(h_(missingColumn,0)==1_K);
assert(B*h==0);
assert(DB==id_(K^q)-h*eMissing);
a=A*h;
i=0;j=0;delta=0_K;
for ii from 0 to q-2 do for jj from ii+1 to q-1 do if delta==0 then (corankMinor=h_(ii,0)*a_(jj,0)-h_(jj,0)*a_(ii,0); if corankMinor!=0 then (i=ii;j=jj;delta=corankMinor));
assert(delta!=0);
ei=matrix{apply(q,kk->if kk==i then 1_K else 0_K)};
ej=matrix{apply(q,kk->if kk==j then 1_K else 0_K)};
Fh=(a_(j,0)*ei-a_(i,0)*ej)/delta;
Fa=(-h_(j,0)*ei+h_(i,0)*ej)/delta;
assert(Fh*h==matrix{{1_K}} and Fh*a==0);
assert(Fa*h==0 and Fa*a==matrix{{1_K}});
c=D*w;c=c-h*(Fh*c);
assert(B*c==w and Fh*c==0);
D0=(id_(K^q)-h*Fh)*D;
assert(D0*B==id_(K^q)-h*Fh);
print("attempt04: exact complement, observability and target compatibility checked without generic rerank"); flush stdio;
linrows=apply(select(toList(0..q-1),jj->jj!=i and jj!=j),jj->(matrix{apply(q,kk->if kk==jj then 1_K else 0_K)}-h_(jj,0)*Fh-a_(jj,0)*Fa));
assert(all(linrows,rr->rr*h==0 and rr*a==0));
linN0=apply(linrows,rr->(transpose rr)||(-transpose(rr*A*D)));
linN1=apply(linrows,rr->(matrix apply(q,ii->{0_K}))||(-transpose(rr*D)));
gN0=(transpose Fh)||(-transpose(Fh*A*D));
gN1=(-transpose Fa)||(transpose((Fa*A-Fh)*D));
gN2=(matrix apply(q,ii->{0_K}))||(transpose(Fa*D));
R=K[lambda];LL=(lambda*id_(R^q)+sub(A,R))||sub(B,R);UU=sub(v||w,R);
ns=apply(toList(0..#linN0-1),j->sub(linN0#j,R)+lambda*sub(linN1#j,R));
ls=apply(ns,nn->(transpose nn*UU)_(0,0));
ng=sub(gN0,R)+lambda*sub(gN1,R)+lambda^2*sub(gN2,R);
gg=(transpose ng*UU)_(0,0);
assert(all(ns,nn->transpose nn*LL==0));
assert(transpose ng*LL==0);
print("attempt04: sixteen linear and one quadratic obstruction built"); flush stdio;
J=ideal(join(ls,{gg})); print gens gb J; flush stdio;
assert(J==ideal(1_R));
NN=0;
for ii from 0 to #ls-1 do if NN===0 then (aa=sub(ls#ii,{lambda=>0_R}); bb=sub((ls#ii-aa)/lambda,K); if bb==0 and aa!=0 then NN=ns#ii/aa);
firstLinearPosition=position(ls,ll->ll!=0_R);
if NN===0 and firstLinearPosition===null then (assert(degree gg=={0}); NN=ng/gg);
if NN===0 then (
 ll=ls#firstLinearPosition;aa=sub(ll,{lambda=>0_R});bb=sub((ll-aa)/lambda,K); assert(bb!=0); alpha=-sub(aa,K)/bb;
 for ii from 0 to #ls-1 do if NN===0 then (at=sub(ls#ii,{lambda=>sub(alpha,R)}); if at!=0 then (bi=sub((ls#ii-sub(ls#ii,{lambda=>0_R}))/lambda,K); NN=(ns#ii-(bi/bb)*ns#firstLinearPosition)/at));
 if NN===0 then (at=sub(gg,{lambda=>sub(alpha,R)}); assert(at!=0); coeff=(gg-at)//ll; assert(coeff*ll==gg-at); NN=(ng-coeff*ns#firstLinearPosition)/at)
 );
assert(transpose NN*LL==0);
assert((transpose NN*UU)_(0,0)==1_R);
print("PASS bounded attempt04 full dual algorithm syntax only");exit 0;
