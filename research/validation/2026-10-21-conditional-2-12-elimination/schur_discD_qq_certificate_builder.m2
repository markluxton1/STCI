schurMinors=apply(select(toList(0..11),j->not member(j,pivotRows)),j->det submatrix(augmented,join(pivotRows,{j}),toList(0..4)));
chartIdeal=ideal join(schurMinors,{symbolInverse*symbolDet-1,pivotInverse*pivotDet-1});
print("SCHUR_READY: 4 root parameters,8 compatibility determinants,2 explicit chart inverses");
-- This is a necessary incidence without K2 or torsion; no emptiness claimed.

quarticI=12-3*d1*d3+d2^2;
quarticJ=72*d2+9*d1*d2*d3-27*d1^2-27*d3^2-2*d2^3;
discD=(4*quarticI^3-quarticJ^2)/27;
testIdeal=chartIdeal+ideal discD;
certGB=gb(testIdeal,ChangeMatrix=>true);
assert(gens certGB==matrix{{1_R}});
certCoefficients=flatten entries getChangeMatrix certGB;
assert(gens testIdeal*transpose matrix{certCoefficients}==matrix{{1_R}});
"/Users/markluxton/Projects/STCI/research/validation/2026-10-21-conditional-2-12-elimination/schur_discD_qq_certificate.m2" << "certificateCoefficients={" << demark(",",apply(certCoefficients,toString)) << "};\nassert(gens testIdeal*transpose matrix{certificateCoefficients}==matrix{{1_R}});\nprint \"EXACT_UNIT_IDENTITY_VERIFIED\";\n" << close;
print "CERTIFICATE_EXPORTED_AND_VERIFIED";
