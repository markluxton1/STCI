-- Exact bounded coefficient incidence; no parameter-space exhaustion.
rootCheck=(label,condition)->(assert(condition);print("PASS "|label));
rootRing=QQ[delta,a,B,G,J,p,q,tt,kappa];
F=value get "research/validation/2026-10-12-nonendpoint-diagonal-norm/20261012T212553449292Z/primitive-polynomial.txt";
Gs=-(6*B+delta^2-3*delta)*q-(3*a-3*B+2*delta)*q^2+2*a*q^3;
Js=(-Gs*(1+3*q)-(6*B+5*delta^2-3*delta)*q-(3*a+3*B+delta-delta^2)*q^2+(a+B)*q^3)/2;
Pt=G+(6*B+delta^2-3*delta)*p+(3*a-3*B+2*delta)*p^2-2*a*p^3;
Jt=G+2*J+(6*B+3*G+5*delta^2-3*delta)*p+(3*a+3*B+delta-delta^2)*p^2-(a+B)*p^3;
rootCheck("complete finite common-root substitution",sub(Pt,{G=>Gs,p=>q})==0 and sub(Jt,{G=>Gs,J=>Js,p=>q})==0);
Fshift=sub(F,{G=>Gs,J=>Js,p=>q+tt});
rootCheck("automatic common-root factor",sub(Fshift,{tt=>0})==0);
cc=apply(0..8,n->(sum select(terms Fshift,mm->((exponents mm)#0)#7==n))//tt^n);
rootCheck("all Taylor coefficients reconstruct polynomial",Fshift==sum apply(0..8,n->cc#n*tt^n));
Pq=q^2-6*q+6; Lq=a*q^2+(B-delta)*q-delta^2;
rootCheck("fiber denominator on common-root incidence",Gs*q*(2-q)+Js*(3-q)==q*Pq*Lq);
H12=Gs+(3-q)*(delta^2+B*q); H13=Js-q*(2-q)*(delta^2+B*q);
rootCheck("retained rank-one coefficients",H12==-(3-2*q)*Lq and H13==q*(4-3*q)*Lq);
L1=3*(a*q+B)*(q-1)^2*Pq+delta*q*(3-2*q)*Pq-3*delta^2*(q-1)^2*(q-3);
L2=cc#1//(-delta*q*L1);
rootCheck("compact first Taylor factor",cc#1==-delta*q*L1*L2);
rootCheck("first factor exceptional target one",sub(L1,{q=>1})==delta);
PcRemainder=(L1+3*delta^2*(q-1)^2*(q-3))//Pq;
rootCheck("first factor retains collision targets",L1+3*delta^2*(q-1)^2*(q-3)==Pq*PcRemainder);
L2k=sub(L2,{B=>kappa-a*q});
print("L2 in a,kappa=aq+B: monomials="|toString(#terms L2k)|" a-degree="|toString max apply(exponents L2k,ee->ee#1));
"/private/tmp/nonendpoint_single_root_L1.txt" << toString L1 << close;
"/private/tmp/nonendpoint_single_root_L2.txt" << toString L2 << close;
"/private/tmp/nonendpoint_single_root_L2_kappa.txt" << toString L2k << close;
scan(1..8,n->(("/private/tmp/nonendpoint_single_root_u"|toString(n-1)|".txt") << toString cc#n << close));
print "PASS all eight single-root coefficient checks";
