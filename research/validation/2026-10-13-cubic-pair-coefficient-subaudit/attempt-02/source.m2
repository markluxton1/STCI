-- Independent algebra subaudit of the cubic-pair PAIR condition.
-- Characteristic zero. No inversion of a factor difference, or normalization of delta.
checkCount=0;
cpAssert=(name,truth)->(if not truth then error("FAIL "|name); checkCount=checkCount+1; print("PASS "|toString(checkCount)|" "|name));
R=QQ[cpDelta,cpA,cpB,cpG,cpJ,cpS1,cpS2,cpP1,cpP2,cpX,cpR,cpT,cpH1,cpH2,cpP33a,cpP33b];
bbLift=cpA+cpB; ggLift=cpA+3*cpB+cpG; ddLift=cpA+4*cpB+2*cpG+cpJ;
modA=cpG+cpJ;
beta=cpA*ddLift-bbLift*ggLift;
cpAssert("actual determinant beta", beta==cpA*modA-3*cpB^2-cpB*cpG);
coefC=(4*cpA-3*bbLift-ggLift)*cpDelta-3*cpDelta^3-modA;
coefE=beta+cpDelta^4;
coefP=beta+(6*cpA-3*bbLift)*cpDelta^2+3*cpDelta^3;
coefL=(-4*cpA+bbLift)*cpDelta^3-cpDelta^4;
coefN=cpA*cpDelta^4;
actualF=modA*cpT^2+(coefC*cpR+coefE)*cpT+(-3*cpDelta^2-modA)*cpR^3+coefP*cpR^2+coefL*cpR+coefN;
K=ideal(cpJ+cpG+3*cpDelta^2);
cpAssert("actual rt coefficient on cubic hyperplane", (coefC-((-6*cpB-cpG)*cpDelta-3*cpDelta^3+3*cpDelta^2))%K==0);
cpAssert("actual r squared coefficient on cubic hyperplane", (coefP-(-3*cpB^2-cpB*cpG-3*cpB*cpDelta^2+3*cpDelta^3))%K==0);
factorF=-3*cpDelta^2*(cpT+cpDelta*cpS1*cpR-cpDelta^2*cpP1)*(cpT+cpDelta*cpS2*cpR-cpDelta^2*cpP2);
cpAssert("factor coefficient expansion including equal factors", factorF==-3*cpDelta^2*cpT^2-3*cpDelta^3*(cpS1+cpS2)*cpR*cpT+3*cpDelta^4*(cpP1+cpP2)*cpT-3*cpDelta^4*cpS1*cpS2*cpR^2+3*cpDelta^5*(cpS1*cpP2+cpS2*cpP1)*cpR-3*cpDelta^6*cpP1*cpP2);
subs1={cpB=>cpX*cpDelta^2,cpA=>-3*cpDelta^2*cpP1*cpP2,cpG=>3*cpDelta^2*(cpS1+cpS2-1)-6*cpX*cpDelta^2+3*cpDelta,cpJ=>-3*cpDelta^2-cpG};
-- Do hyperplane substitution before a,G substitutions; avoid simultaneous substitution ambiguity.
Fhyper=sub(actualF,{cpJ=>-3*cpDelta^2-cpG});
Fsub=sub(Fhyper,{cpB=>cpX*cpDelta^2,cpA=>-3*cpDelta^2*cpP1*cpP2,cpG=>3*cpDelta^2*(cpS1+cpS2-1)-6*cpX*cpDelta^2+3*cpDelta});
diffF=Fsub-factorF;
Qtwo=cpDelta*(cpS1*cpS2+cpX^2-cpX*(cpS1+cpS2))-cpX+1;
Qzero=cpDelta*(cpX-cpS1*cpS2+1/3-cpP1-cpP2+3*cpP1*cpP2)-1;
Qone=cpDelta*(cpX+9*cpP1*cpP2-3*cpS1*cpP2-3*cpS2*cpP1)-1;
pairE=(sA,pA,sB,pB)->sA*sB-3*sA*pB-3*sB*pA+pA+pB+6*pA*pB-1/3;
PAIR=pairE(cpS1,cpP1,cpS2,cpP2);
normCoef=(v)->sub(sub(v,{cpJ=>-3*cpDelta^2-cpG}),{cpB=>cpX*cpDelta^2,cpA=>-3*cpDelta^2*cpP1*cpP2,cpG=>3*cpDelta^2*(cpS1+cpS2-1)-6*cpX*cpDelta^2+3*cpDelta});
cpAssert("rt and constant coefficients vanish after necessary substitutions", normCoef(coefC)==-3*cpDelta^3*(cpS1+cpS2) and normCoef(coefN)==-3*cpDelta^6*cpP1*cpP2);
cpAssert("r squared coefficient is 3 delta cubed Q2", (normCoef(coefP)+3*cpDelta^4*cpS1*cpS2)==3*cpDelta^3*Qtwo);
cpAssert("t coefficient minus r squared coefficient is 3 delta cubed Q0", (normCoef(coefE)-3*cpDelta^4*(cpP1+cpP2))-(normCoef(coefP)+3*cpDelta^4*cpS1*cpS2)==3*cpDelta^3*Qzero);
cpAssert("r coefficient is delta fourth Q1", (normCoef(coefL)-3*cpDelta^5*(cpS1*cpP2+cpS2*cpP1))==cpDelta^4*Qone);
cpAssert("PAIR equals modulus-free coefficient difference", Qone-Qzero==cpDelta*PAIR);
cpAssert("all residual coefficients reconstructed", diffF==3*cpDelta^3*Qtwo*cpR^2+3*cpDelta^3*(Qzero+Qtwo)*cpT+cpDelta^4*Qone*cpR);
p15A=(cpH1+1)/2-5/42; p15B=(cpH2+1)/2-5/42;
p24A=5/12+cpH1/2-cpH1^2/4; p24B=5/12+cpH2/2-cpH2^2/4;
f15A=7*cpH1^2-12; f15B=7*cpH2^2-12;
f24A=63*cpH1^4-30*cpH1^2-1; f24B=63*cpH2^4-30*cpH2^2-1;
f33A=7*cpP33a^2-5*cpP33a+1; f33B=7*cpP33b^2-5*cpP33b+1;
E1515=pairE(cpH1+1,p15A,cpH2+1,p15B);
E1524=pairE(cpH1+1,p15A,cpH2+1,p24B);
E1533=pairE(cpH1+1,p15A,1,cpP33b);
E2424=pairE(cpH1+1,p24A,cpH2+1,p24B);
E2433=pairE(cpH1+1,p24A,1,cpP33b);
E3333=pairE(1,cpP33a,1,cpP33b);
cpAssert("15/15 exact expression",E1515==2/147-cpH1*cpH2/2);
cpAssert("15/24 exact expression",42*E1524==1-3*cpH2^2-21*cpH1*cpH2);
cpAssert("15/33 exact expression",E1533==(2/7)*(cpP33b-1/3));
cpAssert("24/24 exact expression",24*E2424==(1-3*cpH1^2)*(1-3*cpH2^2)-12*cpH1*cpH2);
cpAssert("24/33 exact expression",E2433==(3*cpH1^2-1)*(1-3*cpP33b)/6);
cpAssert("33/33 exact expression",E3333==(2/3)*(1-3*cpP33a)*(1-3*cpP33b));
-- A unit ideal means no solution over any characteristic-zero algebraically closed extension.
unitCheck=(name,L)->cpAssert(name,ideal(L)==ideal(1_R));
unitCheck("15/15 unit ideal including equal factors",{f15A,f15B,E1515});
unitCheck("15/24 unit ideal",{f15A,f24B,E1524});
unitCheck("15/33 unit ideal",{f15A,f33B,E1533});
unitCheck("24/24 unit ideal including equal factors",{f24A,f24B,E2424});
unitCheck("24/33 unit ideal",{f24A,f33B,E2433});
unitCheck("33/33 unit ideal including equal factors",{f33A,f33B,E3333});
unitCheck("15 repeated cubic explicit diagonal",{f15A,sub(E1515,{cpH2=>cpH1})});
unitCheck("24 repeated cubic explicit diagonal",{f24A,sub(E2424,{cpH2=>cpH1})});
unitCheck("33 repeated cubic explicit diagonal",{f33A,sub(E3333,{cpP33b=>cpP33a})});
cpAssert("15/24 forced e value is incompatible",sub(63*cpH1^2-30*cpH1-1,{cpH1=>1/663})==-459396/439569);
cpAssert("24/24 distinct e roots contradiction",16/49 != -16/7);
cpAssert("24/24 same sign e value incompatible",sub(63*cpH1^2-30*cpH1-1,{cpH1=>1/12})==-49/16);
cpAssert("24/24 opposite sign e value incompatible",sub(63*cpH1^2-30*cpH1-1,{cpH1=>-1/3})==16);
print("FINAL PASS "|toString(checkCount)|" independent algebra identities and unit-ideal conditions");
