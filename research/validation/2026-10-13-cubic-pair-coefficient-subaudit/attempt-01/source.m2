-- Independent algebra subaudit of the cubic-pair PAIR condition.
-- Characteristic zero. No inversion of a factor difference, or normalization of delta.
checkCount=0;
check=(name,truth)->(if not truth then error("FAIL "|name); checkCount=checkCount+1; print("PASS "|toString(checkCount)|" "|name));
R=QQ[dd,aa,bb,gg,jj,sOne,sTwo,pOne,pTwo,xx,rr,tt,hOne,hTwo,pp,qq];
bbLift=aa+bb; ggLift=aa+3*bb+gg; ddLift=aa+4*bb+2*gg+jj;
modA=gg+jj;
beta=aa*ddLift-bbLift*ggLift;
check("actual determinant beta", beta==aa*modA-3*bb^2-bb*gg);
coefC=(4*aa-3*bbLift-ggLift)*dd-3*dd^3-modA;
coefE=beta+dd^4;
coefP=beta+(6*aa-3*bbLift)*dd^2+3*dd^3;
coefL=(-4*aa+bbLift)*dd^3-dd^4;
coefN=aa*dd^4;
actualF=modA*tt^2+(coefC*rr+coefE)*tt+(-3*dd^2-modA)*rr^3+coefP*rr^2+coefL*rr+coefN;
K=ideal(jj+gg+3*dd^2);
check("actual rt coefficient on cubic hyperplane", (coefC-((-6*bb-gg)*dd-3*dd^3+3*dd^2))%K==0);
check("actual r squared coefficient on cubic hyperplane", (coefP-(-3*bb^2-bb*gg-3*bb*dd^2+3*dd^3))%K==0);
factorF=-3*dd^2*(tt+dd*sOne*rr-dd^2*pOne)*(tt+dd*sTwo*rr-dd^2*pTwo);
check("factor coefficient expansion including equal factors", factorF==-3*dd^2*tt^2-3*dd^3*(sOne+sTwo)*rr*tt+3*dd^4*(pOne+pTwo)*tt-3*dd^4*sOne*sTwo*rr^2+3*dd^5*(sOne*pTwo+sTwo*pOne)*rr-3*dd^6*pOne*pTwo);
subs1={bb=>xx*dd^2,aa=>-3*dd^2*pOne*pTwo,gg=>3*dd^2*(sOne+sTwo-1)-6*xx*dd^2+3*dd,jj=>-3*dd^2-gg};
-- Do hyperplane substitution before a,G substitutions; avoid simultaneous substitution ambiguity.
Fhyper=sub(actualF,{jj=>-3*dd^2-gg});
Fsub=sub(Fhyper,{bb=>xx*dd^2,aa=>-3*dd^2*pOne*pTwo,gg=>3*dd^2*(sOne+sTwo-1)-6*xx*dd^2+3*dd});
diffF=Fsub-factorF;
Qtwo=dd*(sOne*sTwo+xx^2-xx*(sOne+sTwo))-xx+1;
Qzero=dd*(xx-sOne*sTwo+1/3-pOne-pTwo+3*pOne*pTwo)-1;
Qone=dd*(xx+9*pOne*pTwo-3*sOne*pTwo-3*sTwo*pOne)-1;
pairE=(sA,pA,sB,pB)->sA*sB-3*sA*pB-3*sB*pA+pA+pB+6*pA*pB-1/3;
PAIR=pairE(sOne,pOne,sTwo,pTwo);
check("rt and constant coefficients vanish after necessary substitutions", coefficient(rr*tt,diffF)==0 and coefficient(1_R,diffF)==0);
check("r squared coefficient is 3 delta cubed Q2", coefficient(rr^2,diffF)==3*dd^3*Qtwo);
check("t coefficient minus r squared coefficient is 3 delta cubed Q0", coefficient(tt,diffF)-coefficient(rr^2,diffF)==3*dd^3*Qzero);
check("r coefficient is delta fourth Q1", coefficient(rr,diffF)==dd^4*Qone);
check("PAIR equals modulus-free coefficient difference", Qone-Qzero==dd*PAIR);
check("all residual coefficients reconstructed", diffF==3*dd^3*Qtwo*rr^2+3*dd^3*(Qzero+Qtwo)*tt+dd^4*Qone*rr);
p15A=(hOne+1)/2-5/42; p15B=(hTwo+1)/2-5/42;
p24A=5/12+hOne/2-hOne^2/4; p24B=5/12+hTwo/2-hTwo^2/4;
f15A=7*hOne^2-12; f15B=7*hTwo^2-12;
f24A=63*hOne^4-30*hOne^2-1; f24B=63*hTwo^4-30*hTwo^2-1;
f33A=7*pp^2-5*pp+1; f33B=7*qq^2-5*qq+1;
E1515=pairE(hOne+1,p15A,hTwo+1,p15B);
E1524=pairE(hOne+1,p15A,hTwo+1,p24B);
E1533=pairE(hOne+1,p15A,1,qq);
E2424=pairE(hOne+1,p24A,hTwo+1,p24B);
E2433=pairE(hOne+1,p24A,1,qq);
E3333=pairE(1,pp,1,qq);
check("15/15 exact expression",E1515==2/147-hOne*hTwo/2);
check("15/24 exact expression",42*E1524==1-3*hTwo^2-21*hOne*hTwo);
check("15/33 exact expression",E1533==(2/7)*(qq-1/3));
check("24/24 exact expression",24*E2424==(1-3*hOne^2)*(1-3*hTwo^2)-12*hOne*hTwo);
check("24/33 exact expression",E2433==(3*hOne^2-1)*(1-3*qq)/6);
check("33/33 exact expression",E3333==(2/3)*(1-3*pp)*(1-3*qq));
-- A unit ideal means no solution over any characteristic-zero algebraically closed extension.
unitCheck=(name,L)->check(name,ideal(L)==ideal(1_R));
unitCheck("15/15 unit ideal including equal factors",{f15A,f15B,E1515});
unitCheck("15/24 unit ideal",{f15A,f24B,E1524});
unitCheck("15/33 unit ideal",{f15A,f33B,E1533});
unitCheck("24/24 unit ideal including equal factors",{f24A,f24B,E2424});
unitCheck("24/33 unit ideal",{f24A,f33B,E2433});
unitCheck("33/33 unit ideal including equal factors",{f33A,f33B,E3333});
unitCheck("15 repeated cubic explicit diagonal",{f15A,sub(E1515,{hTwo=>hOne})});
unitCheck("24 repeated cubic explicit diagonal",{f24A,sub(E2424,{hTwo=>hOne})});
unitCheck("33 repeated cubic explicit diagonal",{f33A,sub(E3333,{qq=>pp})});
check("15/24 forced e value is incompatible",sub(63*hOne^2-30*hOne-1,{hOne=>1/663})==-459396/439569);
check("24/24 distinct e roots contradiction",16/49 != -16/7);
check("24/24 same sign e value incompatible",sub(63*hOne^2-30*hOne-1,{hOne=>1/12})==-49/16);
check("24/24 opposite sign e value incompatible",sub(63*hOne^2-30*hOne-1,{hOne=>-1/3})==16);
print("FINAL PASS "|toString(checkCount)|" independent algebra identities and unit-ideal conditions");
