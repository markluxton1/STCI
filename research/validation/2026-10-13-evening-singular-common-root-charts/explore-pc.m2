R=QQ[delta,a,kappa,q,r,T];
B=kappa-a*q;
Gs=-(6*B+delta^2-3*delta)*q-(3*a-3*B+2*delta)*q^2+2*a*q^3;
Js=(-Gs*(1+3*q)-(6*B+5*delta^2-3*delta)*q-(3*a+3*B+delta-delta^2)*q^2+(a+B)*q^3)/2;
Pc=q^2-6*q+6;
reducePc=ff->ff%Pc;
H12=Gs+q*(3-q)*(delta*r+B);
H13=Js-q^2*(2-q)*(delta*r+B);
R2=-delta*r*(q*r-delta)*((3-q)*r-delta);
R3=delta*(q*r-delta)*(q*(2-q)*r^2+delta*(2-q)*r-delta^2);
Ac=(3*delta^2+Gs)*q*(2-q)+Js*(3-q);
bc=delta*(delta^2*q*(q-3)+3*B*q*(2-q)+Gs*(2-q)-Js);
cc=delta^2*(B*q*(q-3)-Gs);
A2=Ac*r^2+bc*r+cc;
J0=q*T^2+(delta*r+B-q*(2*r^2+r-a))*T+r^3*(q*r-delta);
print("G="|toString reducePc(Gs));print("J="|toString reducePc(Js));
print("H12="|toString reducePc(H12));print("H13="|toString reducePc(H13));
print("A2="|toString reducePc(A2));
S=R/ideal(Pc);
print("A2 factor="|toString factor sub(A2,S));
print("J0="|toString J0);
