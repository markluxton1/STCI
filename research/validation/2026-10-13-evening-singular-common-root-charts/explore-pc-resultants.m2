pcBase=QQ[q]; pcField=frac(pcBase/ideal(q^2-6*q+6));
normalizedRing=pcField[pcy,pcx,pcd]; qvalue=sub(pcField_0,normalizedRing);
origRing=QQ[delta,a,B,q];
uFiles=apply(0..3,i->value get ("research/validation/2026-10-12-nonendpoint-single-root-taylor/20261013T142033115594Z/nonendpoint_single_root_u"|toString i|".txt"));
mapper=map(normalizedRing,origRing,{normalizedRing_2,normalizedRing_2*normalizedRing_0,normalizedRing_2*normalizedRing_1-normalizedRing_2*normalizedRing_0*qvalue,qvalue});
uPc=apply(uFiles,x->mapper(x));
powers=apply(uPc,f->min apply(exponents f,e->e#2));
low=apply(0..3,i->uPc#i//normalizedRing_2^(powers#i));
assert all(0..3,i->uPc#i==low#i*normalizedRing_2^(powers#i));
print("powers="|toString powers);
print("f0="|toString low#0);print("f1="|toString low#1);print("f2="|toString low#2);
res12=resultant(low#1,low#2,normalizedRing_0);
res13=resultant(low#1,low#3,normalizedRing_0);
res012=resultant(low#0,res12,normalizedRing_1);
res013=resultant(low#0,res13,normalizedRing_1);
print("res012="|toString res012);
print("res013="|toString res013);
print("gcd="|toString gcd(res012,res013));
print "COMPLETE";
