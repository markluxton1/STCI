R=QQ[a,b,x,MonomialOrder=>GRevLex];
R2=-8 * a ^ 3 * b - 64 * a ^ 3 + 80 * a ^ 2 * b ^ 2 * x + 640 * a ^ 2 * b * x + 36 * a ^ 2 * b + 1152 * a ^ 2 * x + 72 * a ^ 2 + 124 * a * b ^ 2 * x + 824 * a * b * x + 70 * a * b + 1008 * a * x + 116 * a + 20 * b ^ 3 * x ^ 2 + 256 * b ^ 2 * x ^ 2 + 92 * b ^ 2 * x + 1008 * b * x ^ 2 + 604 * b * x + 45 * b + 1152 * x ^ 2 + 720 * x + 72;
R4=-20 * a ^ 3 - 20 * a ^ 2 * b ^ 2 * x - 124 * a ^ 2 * b * x - 368 * a ^ 2 * x - 64 * a ^ 2 + 2 * a * b ^ 3 * x ^ 2 - 36 * a * b ^ 2 * x ^ 2 - 40 * a * b ^ 2 * x - 280 * a * b * x ^ 2 - 206 * a * b * x - 720 * a * x ^ 2 - 604 * a * x - 63 * a + 4 * b ^ 3 * x ^ 2 - 18 * b ^ 2 * x ^ 2 - 18 * b ^ 2 * x - 116 * b * x ^ 2 - 63 * b * x - 288 * x ^ 2 - 180 * x - 18;
Q5=16 * a ^ 4 + 48 * a ^ 3 * b ^ 2 * x + 256 * a ^ 3 * b * x + 576 * a ^ 3 * x + 64 * a ^ 3 + 36 * a ^ 2 * b ^ 4 * x ^ 2 + 384 * a ^ 2 * b ^ 3 * x ^ 2 + 1888 * a ^ 2 * b ^ 2 * x ^ 2 + 112 * a ^ 2 * b ^ 2 * x + 4608 * a ^ 2 * b * x ^ 2 + 512 * a ^ 2 * b * x + 5184 * a ^ 2 * x ^ 2 + 1216 * a ^ 2 * x + 88 * a ^ 2 + 70 * a * b ^ 4 * x ^ 2 + 576 * a * b ^ 3 * x ^ 2 + 2096 * a * b ^ 2 * x ^ 2 + 60 * a * b ^ 2 * x + 3456 * a * b * x ^ 2 + 160 * a * b * x + 3040 * a * x ^ 2 + 528 * a * x + 48 * a + 2 * b ^ 5 * x ^ 3 - 4 * b ^ 4 * x ^ 3 + 36 * b ^ 4 * x ^ 2 - 80 * b ^ 3 * x ^ 3 + 192 * b ^ 3 * x ^ 2 - 352 * b ^ 2 * x ^ 3 + 400 * b ^ 2 * x ^ 2 - 736 * b * x ^ 3 + 192 * b * x ^ 2 - 48 * b * x - 576 * x ^ 3 + 9;
Q1=-32*a^5 + a^4*(-144*b^2*x - 1120*b*x - 2304*x + 16) + a^3*(-384*b^2*x - 2304*b*x - 3072*x + 80) + a^2*(-48*b^3*x^2 - 448*b^2*x^2 - 472*b^2*x - 960*b*x^2 - 2096*b*x - 1600*x + 88) + a*(-64*b^3*x^2 - 512*b^2*x^2 - 288*b^2*x - 640*b*x^2 - 864*b*x + 768*x^2 - 192*x + 46) - 4*b^4*x^3 - 64*b^3*x^3 - 36*b^3*x^2 - 352*b^2*x^3 - 304*b^2*x^2 - 81*b^2*x - 768*b*x^3 - 528*b*x^2 - 190*b*x - 576*x^3 + 9;
Q2=a^4*(-16*b - 128) + a^3*(160*b^2*x + 1280*b*x + 64*b + 2304*x + 80) + a^2*(328*b^2*x + 2288*b*x + 176*b + 3168*x + 304) + a*(40*b^3*x^2 + 512*b^2*x^2 + 308*b^2*x + 2016*b*x^2 + 2032*b*x + 160*b + 2304*x^2 + 2448*x + 260) + 20*b^3*x^2 + 256*b^2*x^2 + 92*b^2*x + 1008*b*x^2 + 604*b*x + 45*b + 1152*x^2 + 720*x + 72;
Q3=-16*a^4 + a^3*(-32*b*x - 192*x - 48) + a^2*(-96*b^2*x^2 + 24*b^2*x - 960*b*x^2 - 48*b*x - 2304*x^2 - 672*x - 72) + a*(8*b^3*x^2 + 48*b^2*x^2 + 60*b^2*x - 480*b*x^2 + 120*b*x - 1856*x^2 - 384*x - 44) + 4*b^4*x^3 + 48*b^3*x^3 + 12*b^3*x^2 + 288*b^2*x^3 + 168*b^2*x^2 + 36*b^2*x + 704*b*x^3 + 384*b*x^2 + 116*b*x + 576*x^3 - 9;
Q4=a^3*(-40*b - 80) + a^2*(-40*b^3*x - 328*b^2*x - 1232*b*x - 128*b - 1472*x - 256) + a*(4*b^4*x^2 - 64*b^3*x^2 - 80*b^3*x - 704*b^2*x^2 - 572*b^2*x - 2560*b*x^2 - 2032*b*x - 126*b - 2880*x^2 - 2416*x - 252) + 8*b^4*x^2 - 20*b^3*x^2 - 36*b^3*x - 304*b^2*x^2 - 198*b^2*x - 1040*b*x^2 - 612*b*x - 36*b - 1152*x^2 - 720*x - 72;
Q5=16*a^4 + a^3*(48*b^2*x + 256*b*x + 576*x + 64) + a^2*(36*b^4*x^2 + 384*b^3*x^2 + 1888*b^2*x^2 + 112*b^2*x + 4608*b*x^2 + 512*b*x + 5184*x^2 + 1216*x + 88) + a*(70*b^4*x^2 + 576*b^3*x^2 + 2096*b^2*x^2 + 60*b^2*x + 3456*b*x^2 + 160*b*x + 3040*x^2 + 528*x + 48) + 2*b^5*x^3 - 4*b^4*x^3 + 36*b^4*x^2 - 80*b^3*x^3 + 192*b^3*x^2 - 352*b^2*x^3 + 400*b^2*x^2 - 736*b*x^3 + 192*b*x^2 - 48*b*x - 576*x^3 + 9;
s=x*(b*x-a)*(2*a+1)*(b+2);
I=ideal(R2,R4,Q5);
J=saturate(I,ideal(s));
print ("three-equation residual unit: " | toString(J==ideal(1_R)));
print ("three-equation residual dim: " | toString(dim J));
print ("three-equation residual degree: " | toString(degree J));
K=saturate(ideal(Q1,Q2,Q3,Q4,Q5),ideal(s));
print ("full P044 residual unit: " | toString(K==ideal(1_R)));
print ("full P044 residual basis: " | toString(gens gb K));
F=matrix{{Q1,Q2,Q3,Q4,Q5}};
L=ideal F;
n=0;
while ((s^n % L) != 0_R) do n=n+1;
print ("membership exponent: " | toString n);
C=matrix{{s^n}} // F;
assert(F*C==matrix{{s^n}});
print ("certificate verified: " | toString(F*C==matrix{{s^n}}));
"research/computations/session_dx1_saturation_certificate_2026_10_06.txt" << toExternalString C << close;
