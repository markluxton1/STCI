-- Cubic residual/contact identities only. No parameter-space exhaustion.
R=QQ[rr,tt,aa,bb,gg,liftD,sepD,mm,nn,MonomialOrder=>Lex];
actualT=rr^2-mm*rr-nn;
u4=rr^4-(2*rr^2+rr)*actualT+actualT^2;
u3=rr^3-rr*actualT;
x0=u4+aa*actualT;
x1=u4-sepD*u3+bb*actualT;
x2=u4-3*sepD*u3+3*sepD^2*rr^2-sepD^3*rr+gg*actualT;
x3=u4-4*sepD*u3+6*sepD^2*rr^2-4*sepD^3*rr+sepD^4+liftD*actualT;
f0=-rr^3+(mm^2+mm+aa)*rr^2+(nn*(2*mm+1)-aa*mm)*rr+nn^2-aa*nn;
f1=-rr^3+(mm^2+mm-sepD*mm+bb)*rr^2+(nn*(2*mm+1-sepD)-bb*mm)*rr+nn^2-bb*nn;
f2=-rr^3+(mm^2+mm-3*sepD*mm+3*sepD^2+gg)*rr^2+(nn*(2*mm+1-3*sepD)-sepD^3-gg*mm)*rr+nn^2-gg*nn;
f3=-rr^3+(mm^2+mm-4*sepD*mm+6*sepD^2+liftD)*rr^2+(nn*(2*mm+1-4*sepD)-4*sepD^3-liftD*mm)*rr+nn^2-liftD*nn+sepD^4;
assert(x0==f0 and x1==f1 and x2==f2 and x3==f3);
print "PASS 1: all four actual cubic restrictions";
parA=aa+liftD-bb-gg;
parB=aa*liftD-bb*gg;
resC=(4*aa-3*bb-gg)*sepD-3*sepD^3-parA;
resE=parB+sepD^4;
resP=parB+(6*aa-3*bb)*sepD^2+3*sepD^3;
resL=(-4*aa+bb)*sepD^3-sepD^4;
resN=aa*sepD^4;
resF=parA*tt^2+(resC*rr+resE)*tt+(-3*sepD^2-parA)*rr^3+resP*rr^2+resL*rr+resN;
resOnCubic=substitute(resF,{tt=>-mm*rr-nn});
assert(f0*f3-f1*f2==actualT*resOnCubic);
print "PASS 2: actual quadric equals T times residual restriction";
onPair={liftD=>bb+gg-aa-3*sepD^2};
pairC=substitute(resC,onPair);
pairE=substitute(resE,onPair);
pairP=substitute(resP,onPair);
pairL=substitute(resL,onPair);
pairN=substitute(resN,onPair);
d2=-3*sepD^2*mm^2-pairC*mm+pairP;
d1=-6*sepD^2*mm*nn-pairC*nn-pairE*mm+pairL;
d0=-3*sepD^2*nn^2-pairE*nn+pairN;
assert(substitute(resOnCubic,onPair)==d2*rr^2+d1*rr+d0);
print "PASS 3: complete cubic divisor conditions, including repetitions";
kappa=aa-gg+3*sepD*mm-3*sepD^2;
liftB=bb-aa;
liftG=gg-3*bb+2*aa;
liftJ=substitute(liftD-2*gg+2*bb-aa,onPair);
assert(kappa*(liftB-sepD*mm)-3*sepD^2*(mm-sepD)==d2);
assert(kappa+3*liftB-3*sepD*mm==liftJ);
print "PASS 4: factor difference and exact infinity contact coefficient";
p0=f2-f0;
p1=substitute(f3-f1,onPair);
assert(p1-p0==sepD^2*(3*(mm-sepD)*rr+sepD^2+3*nn));
print "PASS 5: actual quadratic factor numerator difference";
assert((f0^2*f2-f1^3)%actualT==0);
assert((f2^3-f1*f3^2)%actualT==0);
print "PASS 6: both actual cubic equations of C pull back through T";
S=(QQ[qv,wv,uv,kv,hv,jv,mv,nv])[rv];
q0=-rv^2+qv*rv+wv;
qd=hv*rv+jv;
q1=q0+qd;
l0=rv-uv;
l1=l0+kv;
contact=l1*q0^3-l0*q1^3;
assert(contact==kv*q0^3-l0*qd*(3*q0^2+3*q0*qd+qd^2));
assert(coefficient(rv^7,contact)==0);
assert(coefficient(rv^6,contact)==-kv-3*hv);
print "PASS 7: binary degree-seven contact and affine leading coefficient";
cc=apply(0..6,i->coefficient(rv^i,contact));
qh4=cc#6;
qh3=cc#5+mv*cc#6;
qh2=cc#4+mv*cc#5+(mv^2+nv)*cc#6;
qh1=cc#3+mv*cc#4+(mv^2+nv)*cc#5+(mv^3+2*mv*nv)*cc#6;
qh0=cc#2+mv*cc#3+(mv^2+nv)*cc#4+(mv^3+2*mv*nv)*cc#5+(mv^4+3*mv^2*nv+nv^2)*cc#6;
rem1=cc#1+mv*cc#2+(mv^2+nv)*cc#3+(mv^3+2*mv*nv)*cc#4+(mv^4+3*mv^2*nv+nv^2)*cc#5+(mv^5+4*mv^3*nv+3*mv*nv^2)*cc#6;
rem0=cc#0+nv*cc#2+mv*nv*cc#3+(mv^2*nv+nv^2)*cc#4+(mv^3*nv+2*mv*nv^2)*cc#5+(mv^4*nv+3*mv^2*nv^2+nv^3)*cc#6;
contactQuotient=qh4*rv^4+qh3*rv^3+qh2*rv^2+qh1*rv+qh0;
assert(contact==(rv^2-mv*rv-nv)*contactQuotient+rem1*rv+rem0);
print "PASS 8: exact quartic quotient recursion and two remainder equations";
V=QQ[ss1,ss2,pp1,pp2,xx,zeta];
sumS=ss1+ss2;
prodS=ss1*ss2;
sumP=pp1+pp2;
prodP=pp1*pp2;
crossSP=ss1*pp2+ss2*pp1;
eEquation=xx^2-xx*(sumS-1)-xx*zeta+3*prodP+1/3-sumP;
pEquation=xx^2-xx*sumS+(1-xx)*zeta+prodS;
lEquation=xx+9*prodP-3*crossSP-zeta;
otherZeta=xx-prodS+1/3-sumP+3*prodP;
pairEquation=prodS-3*crossSP+sumP+6*prodP-1/3;
assert(eEquation-pEquation==otherZeta-zeta);
assert(lEquation-(eEquation-pEquation)==pairEquation);
print "PASS 9: exact necessary cubic-pair equation and both inverse-separation expressions";
linearX=xx*(2/3-sumS+prodS+sumP-3*prodP)+1/3-sumP+3*prodP;
assert(substitute(pEquation,{zeta=>otherZeta})==linearX);
assert(substitute(eEquation,{zeta=>otherZeta})==linearX);
assert(substitute(lEquation,{zeta=>otherZeta})==pairEquation);
print "PASS 10: retained complete matching equation after necessary pair reduction";
print "PASS ALL: 10 supporting identities; no cubic-pair classification claim";
