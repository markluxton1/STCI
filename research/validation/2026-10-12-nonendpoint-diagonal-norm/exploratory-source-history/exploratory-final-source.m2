diagBase=QQ[delta,a,B,G,J,p];
R=diagBase[r];
Z=G*p*(2-p)+J*(3-p);
Ac=(3*delta^2+G)*p*(2-p)+J*(3-p);
Q2=Ac*r^2+delta*(delta^2*p*(p-3)+3*B*p*(2-p)+G*(2-p)-J)*r+delta^2*(B*p*(p-3)-G);
N=delta^2*(p*r-delta)*(3*(2-p)*r-delta*(3-p));
M=delta^2*(3*J*r^2+delta*(2*G-J)*r-delta^2*G);
Psi=p^2*Z^2*r^4+p^2*Z*(2*r^2+r-a)*N+p^2*N^2-M*Z;
C3=Psi//(p*r-delta);
assert(Psi==(p*r-delta)*C3);
assert(coefficient(r^3,C3)==p*Ac^2);
lcLinear=coefficient(r^2,C3)-p*Ac*coefficient(r,Q2);
LinRem=Ac*C3-(p*Ac^2*r+lcLinear)*Q2;
assert(coefficient(r^3,LinRem)==0 and coefficient(r^2,LinRem)==0);
q1=coefficient(r,Q2); q0=sub(Q2,{r=>0});
c2=coefficient(r^2,C3); c1=coefficient(r,C3); c0=sub(C3,{r=>0});
K=c2-p*Ac*q1; E=c1-p*Ac*q0;
Norm8=Ac*q0*E^2-q1*K*q0*E-Ac*q1*E*c0+q1^2*K*c0+Ac^2*c0^2-2*Ac*K*q0*c0+K^2*q0^2;
assert(resultant(Q2,C3,r)==Ac*Norm8);
print("PASS compact Sylvester identity");
fact=factor Norm8;
scan(toList fact,factpair->print("factor exponent="|toString factpair#1|", terms="|toString(#terms factpair#0)|", factor="|if #terms factpair#0 < 15 then toString factpair#0 else "large"));
primitiveNorm=Norm8//(p^2*delta^6*Z^2);
assert(Norm8==p^2*delta^6*Z^2*primitiveNorm);
primitiveBase=lift(primitiveNorm,diagBase);
print("primitive p degree="|toString max apply(exponents primitiveBase,ee->ee#5));
print("primitive p=0="|toString factor sub(primitiveBase,{p=>0}));
leadPrimitive=(sum select(terms primitiveBase,tt->((exponents tt)#0)#5==8))//p^8;
print("primitive p=inf="|toString factor leadPrimitive);
Pinf=-delta^2*r^2+(B^2-delta*B+a*delta^2)*r+a*delta*B;
Qinf=(3*delta^2+G)*r^2+(3*delta*B-delta^3)*r-delta^2*B;
resInf=resultant(Pinf,Qinf,r);
print("target-infinity resultant="|toString factor resInf);
"/private/tmp/nonendpoint_primitive_norm_2026_10_12.txt" << toString primitiveBase << close;
quit;
