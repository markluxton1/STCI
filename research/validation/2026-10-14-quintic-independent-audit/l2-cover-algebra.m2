-- New small rational-cover identities. No inherited checker is imported.
R=QQ[q,m]; K=frac R; T=K[d,k];
Pc=q^2-6*q+6;
D=2*d*(q-1)+q*(q-2);E=d^2+d*(3*q-4)+q*(q-2);
L1=3*k*(q-1)^2*Pc+d*q*(3-2*q)*Pc-3*d^2*(q-1)^2*(q-3);
L2=(3*q*(q-1)*D*k^2-6*d*q*(q-1)*E*k+d^5*q+3*d^4*(q-1)*(3*q-2)+6*d^3*q*(q-1)*(2*q-3)+3*d^2*q^2*(q-1)*(q-2));
disc=(diff(k,L2))^2-4*(diff(k,diff(k,L2))/2)*L2;
assert(disc==12*q*(q-1)*d^5*(d*q*(q-1)-(q-2)*Pc));
print "PASS complete compact L2 discriminant";
dv=3*(q-2)*Pc/(q*(q-1)*(3-m^2));
Dv=2*dv*(q-1)+q*(q-2);Ev=dv^2+dv*(3*q-4)+q*(q-2);
kv=dv*(Ev+m*dv^2/3)/Dv;
phi=map(K,T,{dv,kv});
assert(phi L2==0);
print "PASS rational-cover L2 equation";
assert(3*(Dv*kv/dv-Ev)/dv^2==m);
print "PASS rational-cover inverse m";
assert(Dv==(q-2)*(q*m-3*q+6)*(q*m+3*q-6)/(q*(m^2-3)));
print "PASS rational-cover D factor";
H=q^4*m^2+3*q^4*m-3*q^3*m^2-3*q^4-15*q^3*m+3*q^2*m^2+36*q^3+27*q^2*m-144*q^2-18*q*m+216*q-108;
assert(phi L1==-3*m*(q-2)*Pc^2*H/(q^2*(q-1)*(m^2-3)^2*(q*m+3*q-6)));
print "PASS rational-cover L1 and H identity";
d0=-q*(q-2)/(2*(q-1));k0=-q*(q-2)*(7*q^2-12*q+6)/(24*(q-1)^3);
phi0=map(K,T,{d0,k0});
assert(phi0 L2==0);
print "PASS D-zero actual k solve";
assert(phi0 diff(k,L2)==-3*q^3*(q-2)^4/(4*(q-1)^2));
print "PASS D-zero nonzero linear coefficient";
V=5*q^4-30*q^3+66*q^2-72*q+36;
assert(phi0 L1==-q*(q-2)*V/(8*(q-1)));
print "PASS D-zero L1 and V identity";
assert(sub(disc,{q=>2})==48*d^6);
print "PASS q-two full discriminant";
print "DONE nine small rational-cover identities";
