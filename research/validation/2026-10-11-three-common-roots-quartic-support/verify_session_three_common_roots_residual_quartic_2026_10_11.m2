-- Independent exact algebra for the three-common-root parameter family.
-- No geometric exclusion is asserted by this source.
BaseFamily=QQ[b];
FamilyField=frac BaseFamily;
FamilyRing=FamilyField[z];
familyA=(3/2)*b^2;
familyG=1/(9*b)-2/3;
familyD=1/(54*b^2)-1/(9*b);
familyU=2*familyA*z^3-3*b*z^2-z+familyG;
familyV=3*familyA*z^4-4*b*z^3-2*z^2-z+familyD;
familyLin=familyA*z-b;
familyH=familyA*z^3+z-familyG-1;
familyJ=familyLin*familyV-(familyLin*z-1)*familyU;
familyE=familyJ^2-(3*z*familyLin-1)*familyH*familyJ+familyLin*familyU*familyH^2;
assert(familyV % familyU == 0);
assert(familyE % familyU == 0);
familyS=familyE//familyU;
familyCarrier=familyA^2*familyG-familyA*b-b^3;
print("U="|toString factor familyU);
print("VQUOT="|toString factor (familyV//familyU));
print("S="|toString familyS);
print("SFACT="|toString factor familyS);
print("RESULTANT="|toString factor resultant(familyU,familyS,z));
print("CARRIER="|toString factor familyCarrier);
print("DISCU="|toString factor resultant(familyU,diff(z,familyU),z));
print("DISCS="|toString factor resultant(familyS,diff(z,familyS),z));
familyResultantCore=(12*b^2+116*b+3)*(72*b^4+252*b^3+1126*b^2+513*b+54);
familyDiscCore=(2*b+3)*(2*b^2+9*b+15)^2*(9216*b^6-208896*b^5-2002096*b^4-2800992*b^3-117672*b^2+72*b+45);
familyCoprime=gcd(familyResultantCore,familyDiscCore);
assert(familyCoprime == 1);
assert(familyV//familyU == (3/2)*z+1/(6*b));
assert(familyCarrier == -(3/4)*b^3*(2*b+3));
assert(coefficient(z^4,familyS) == familyCarrier/2);
assert(resultant(familyU,familyS,z) == -(3/2048)*b^5*familyResultantCore);
assert(resultant(familyS,diff(z,familyS),z) == b^9*familyDiscCore/8388608);
print("RESULTANT_DISC_CORE_GCD="|toString familyCoprime);
print("CHECKS=8");
badA=-(3/2)*b^2;
badU=2*badA*z^3-3*b*z^2-z+familyG;
badV=3*badA*z^4-4*b*z^3-2*z^2-z+familyD;
print("NEGATIVE_SIGN_REMAINDER="|toString (badV % badU));
exit 0;
